<local:SettingsPage xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Aether.Gui" x:DataType="local:MainWindowViewModel" x:Class="Aether.Gui.GiftBoardSettingsPage"
  Confirming="{Binding GiftBoard.Confirming}">
  <local:SettingsPage.HeaderContent>
    <ToggleSwitch x:Name="EnabledInput" Classes="plain" AutomationProperties.Name="礼物榜" />
  </local:SettingsPage.HeaderContent>
  <local:SettingsPage.HeaderActions>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock x:Name="OfflineHint" Classes="hint" Text="连上直播间后才能清空和恢复" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding !HasRoomConnection}" />
      <Button x:Name="AskRestoreButton" Height="32" MinHeight="32" Padding="12,0" IsEnabled="{Binding GiftBoard.CanRestore}" Click="AskRestore">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Viewbox Classes="icon" Width="14" Height="14"><Path Data="{StaticResource Icon.Undo}" StrokeThickness="2" /></Viewbox>
          <TextBlock Text="恢复上一期" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button x:Name="AskClearButton" Classes="danger" BorderBrush="{DynamicResource Border.Control}" Height="32" MinHeight="32" Padding="12,0" IsEnabled="{Binding GiftBoard.CanClear}" Click="AskClear">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Viewbox Classes="icon" Width="14" Height="14"><Path Data="{StaticResource Icon.Trash}" StrokeThickness="2" /></Viewbox>
          <TextBlock Text="清空礼物榜" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>
  </local:SettingsPage.HeaderActions>
  <local:SettingsPage.BodyContent>
    <StackPanel Spacing="22">
      <TextBlock x:Name="EnabledReadOnly" Classes="hint" Text="{StaticResource SettingsReadOnlyHint}" />
      <local:PageStatusBar x:Name="PageStatus" DataContext="{Binding WebService.GiftBoard}" />
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <TextBlock Classes="section" Text="上榜门槛" />
          <TextBlock Grid.Column="1" Classes="hint" Text="达到门槛的礼物才显示在礼物榜上" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <NumericUpDown x:Name="ThresholdInput" Minimum="1" Classes.invalid="{Binding #ThresholdError.IsVisible}" FormatString="0.############################" AutomationProperties.Name="上榜门槛（电池）" />
          <TextBlock Text="电池" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="ThresholdReadOnly" Classes="hint" Text="{StaticResource SettingsReadOnlyHint}" />
        <TextBlock x:Name="ThresholdError" Classes="error" />
        <StackPanel Margin="0,4,0,0">
          <RadioButton x:Name="ByUnitPriceInput" Classes="choice" GroupName="ThresholdBy" AutomationProperties.Name="按礼物单价">
            <StackPanel Spacing="3">
              <TextBlock Classes="section" Text="按礼物单价" />
              <TextBlock Classes="hint" Text="单价达到门槛的礼物上榜；盲盒按开出的礼物算" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ByTotalPriceInput" Classes="choice" GroupName="ThresholdBy" AutomationProperties.Name="按累计总价">
            <StackPanel Spacing="3">
              <TextBlock Classes="section" Text="按累计总价" />
              <TextBlock Classes="hint" Text="同一位观众送的同一种礼物，单价 × 个数达到门槛就上榜" />
            </StackPanel>
          </RadioButton>
        </StackPanel>
        <TextBlock x:Name="ThresholdByReadOnly" Classes="hint" Text="{StaticResource SettingsReadOnlyHint}" />
      </StackPanel>
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="3">
            <TextBlock Classes="section" Text="每场开播换新榜" />
            <TextBlock Classes="hint" Text="直播跨天也还是同一张；关掉后，只在点“清空礼物榜”时换" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" x:Name="ResetOnLiveInput" Classes="plain" AutomationProperties.Name="每场开播换新榜" />
        </Grid>
        <TextBlock x:Name="ResetOnLiveReadOnly" Classes="hint" Text="{StaticResource SettingsReadOnlyHint}" />
      </StackPanel>
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="3">
            <TextBlock Classes="section" Text="看板娘" />
            <TextBlock Classes="hint" Text="从标题飘带后面探出来主持；关掉后，她的位置能多放 3 行" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" x:Name="MascotInput" Classes="plain" AutomationProperties.Name="看板娘" />
        </Grid>
        <TextBlock x:Name="MascotReadOnly" Classes="hint" Text="{StaticResource SettingsReadOnlyHint}" />
      </StackPanel>
      <StackPanel Spacing="4">
        <!-- The slider (Width NaN) takes what the text leaves and shortens its track in a narrow window. -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
          <StackPanel Spacing="3">
            <TextBlock Classes="section" Text="新的第一名时响一声" />
            <TextBlock Classes="hint" Text="看板娘欢呼时一声柔和的星光；拉到最左就不响" />
          </StackPanel>
          <Slider Grid.Column="1" x:Name="VolumeInput" Classes="volume" Width="NaN" VerticalAlignment="Center" AutomationProperties.Name="新的第一名音量" />
        </Grid>
        <TextBlock x:Name="VolumeReadOnly" Classes="hint" Text="{StaticResource SettingsReadOnlyHint}" />
      </StackPanel>
    </StackPanel>
  </local:SettingsPage.BodyContent>
  <local:SettingsPage.ConfirmContent>
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock x:Name="ConfirmText" Classes="singleLine" FontSize="13" Foreground="{DynamicResource Text.Secondary}" Text="{Binding GiftBoard.ConfirmText}" VerticalAlignment="Center" />
      <Button x:Name="CancelConfirmButton" Content="取消" Height="34" Padding="14,0" Click="CancelConfirmation" />
      <Button x:Name="ConfirmClearButton" Classes="dangerSolid" Content="清空" Height="34" MinWidth="96" Padding="16,0" FontWeight="SemiBold" IsVisible="{Binding GiftBoard.ConfirmingClear}" Click="Confirm" />
      <Button x:Name="ConfirmRestoreButton" Classes="accent" Content="恢复" Height="34" MinWidth="96" Padding="16,0" FontWeight="SemiBold" IsVisible="{Binding GiftBoard.ConfirmingRestore}" Click="Confirm" />
    </StackPanel>
  </local:SettingsPage.ConfirmContent>
  <local:SettingsPage.ActivityContent>
    <Grid RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2" Margin="16,18,16,8">
        <TextBlock Classes="section" Text="当前榜单" />
        <TextBlock Grid.Column="1" x:Name="BoardCount" Classes="caption muted numeric" Text="{Binding GiftBoard.CountText}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="BoardPeriod" Classes="caption muted singleLine" Text="{Binding GiftBoard.PeriodText}"
          IsVisible="{Binding GiftBoard.PeriodText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </Grid>
      <Panel Grid.Row="1">
        <ListBox x:Name="BoardList" Classes="plain aside" ItemsSource="{Binding GiftBoard.Rows}" IsVisible="{Binding GiftBoard.HasRows}" AutomationProperties.Name="当前榜单">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:GiftBoardListRow">
              <Border Classes="activityRow">
                <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="10">
                  <TextBlock Classes="rank" Text="{Binding Rank}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Classes="singleLine" Text="{Binding Nickname}" FontWeight="SemiBold" />
                    <TextBlock Classes="caption muted singleLine" Text="{Binding Gift}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="caption numeric" Text="{Binding Value}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="BoardEmpty" Classes="hint" TextWrapping="Wrap" Margin="16,8" IsVisible="{Binding !GiftBoard.HasRows}" />
      </Panel>
    </Grid>
  </local:SettingsPage.ActivityContent>
</local:SettingsPage>
