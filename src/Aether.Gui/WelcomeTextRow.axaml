<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="Aether.Gui.WelcomeTextRow">
  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
    <TextBox x:Name="ValueInput" Classes.invalid="{Binding #ErrorMessage.IsVisible}" />
    <Button Grid.Column="1" x:Name="RemoveButton" Classes="ghost danger" Width="28" VerticalAlignment="Center">
      <Viewbox Classes="icon remove"><Path Data="{StaticResource Icon.Remove}" /></Viewbox>
    </Button>
    <TextBlock Grid.Row="1" x:Name="ErrorMessage" Classes="error" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  </Grid>
</UserControl>
