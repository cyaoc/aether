<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Aether.Gui" x:Class="Aether.Gui.VideoPageStatusBar" x:DataType="local:MainWindowViewModel">
      <Border Classes="card notice" Padding="12,8,8,8" Classes.warning="{Binding WebService.ShowVideoSetup}" Classes.error="{Binding WebService.HasWebServiceError}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <Panel>
            <Viewbox Classes="icon" Width="16" Height="16" IsVisible="{Binding WebService.HasVideoConnections}"><Path Data="{StaticResource Icon.Ok}" Stroke="{DynamicResource Success}" StrokeThickness="2" /></Viewbox>
            <Viewbox Classes="icon" Width="16" Height="16" IsVisible="{Binding WebService.ShowVideoSetup}"><Path Data="{StaticResource Icon.Alert}" StrokeThickness="2" /></Viewbox>
            <Viewbox Classes="icon" Width="16" Height="16" IsVisible="{Binding WebService.HasWebServiceError}"><Path Data="{StaticResource Icon.Fail}" StrokeThickness="2" /></Viewbox>
            <Viewbox Classes="icon" Width="16" Height="16" IsVisible="{Binding WebService.IsWebServiceOff}"><Path Data="{StaticResource Icon.Info}" Stroke="{DynamicResource Text.Muted}" StrokeThickness="2" /></Viewbox>
          </Panel>
          <TextBlock Grid.Column="1" x:Name="VideoPageStatusText" Classes="secondary singleLine" Classes.success="{Binding WebService.HasVideoConnections}" Classes.muted="{Binding WebService.IsWebServiceOff}" FontWeight="SemiBold" Text="{Binding WebService.VideoPageText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
          <Button Grid.Column="2" x:Name="OpenGeneralSettingsButton" Classes="ghost" Height="30" Padding="8,0" Foreground="{DynamicResource Accent.Text}" Click="OpenGeneralSettings">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="地址和端口在通用设置" FontSize="13" VerticalAlignment="Center" />
              <Viewbox Classes="icon" Width="14" Height="14"><Path Data="{StaticResource Icon.Next}" StrokeThickness="2" /></Viewbox>
            </StackPanel>
          </Button>
        </Grid>
      </Border>
</UserControl>
