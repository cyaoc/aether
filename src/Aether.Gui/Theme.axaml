<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
      <BoxShadows x:Key="QrShadow">0 8 28 0 #18000000</BoxShadows>
      <!-- Room for PopupShadow around a popup card; Popup discounts its child's margin, so the card does not shift. -->
      <Thickness x:Key="PopupShadowSpace">24,16,24,32</Thickness>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <BoxShadows x:Key="PopupShadow">0 8 24 0 #1F16181D, 0 1 2 0 #1416181D</BoxShadows>
          <SolidColorBrush x:Key="Surface.Content" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Surface.Sidebar" Color="#F6F7F9" />
          <SolidColorBrush x:Key="Surface.Card" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Surface.Aside" Color="#FAFBFC" />
          <SolidColorBrush x:Key="Border" Color="#E3E6EB" />
          <SolidColorBrush x:Key="Border.Subtle" Color="#EEF0F3" />
          <SolidColorBrush x:Key="Border.Control" Color="#D5D9E0" />
          <SolidColorBrush x:Key="Text.Primary" Color="#16181D" />
          <SolidColorBrush x:Key="Text.Secondary" Color="#3D4350" />
          <SolidColorBrush x:Key="Text.Muted" Color="#5B6270" />
          <SolidColorBrush x:Key="Text.Disabled" Color="#B4BAC4" />
          <!-- Same hex as the Light palette Accent in App.axaml, which Fluent controls read. -->
          <SolidColorBrush x:Key="Accent" Color="#3358D4" />
          <SolidColorBrush x:Key="Accent.Text" Color="#2A47B0" />
          <SolidColorBrush x:Key="Accent.Tint" Color="#E6EBFA" />
          <SolidColorBrush x:Key="Accent.OnSolid" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Account.Row" Color="#E3ECFF" />
          <SolidColorBrush x:Key="Guard.Captain.Row" Color="#E0FDFC" />
          <SolidColorBrush x:Key="Guard.Admiral.Row" Color="#FFEFFF" />
          <SolidColorBrush x:Key="Guard.Governor.Row" Color="#FFF4E0" />
          <SolidColorBrush x:Key="Guard.Captain.Badge" Color="#B9EFEE" />
          <SolidColorBrush x:Key="Guard.Captain.BadgeText" Color="#006E70" />
          <SolidColorBrush x:Key="Guard.Admiral.Badge" Color="#F8D7F6" />
          <SolidColorBrush x:Key="Guard.Admiral.BadgeText" Color="#7E3F7C" />
          <SolidColorBrush x:Key="Guard.Governor.Badge" Color="#F7E0BA" />
          <SolidColorBrush x:Key="Guard.Governor.BadgeText" Color="#7D5100" />
          <SolidColorBrush x:Key="Badge.Neutral" Color="#EEF0F3" />
          <SolidColorBrush x:Key="Success" Color="#166534" />
          <SolidColorBrush x:Key="Warning.Background" Color="#FEF8EC" />
          <SolidColorBrush x:Key="Warning.Border" Color="#F5D9A8" />
          <SolidColorBrush x:Key="Warning.Text" Color="#78350F" />
          <SolidColorBrush x:Key="Danger" Color="#B91C1C" />
          <SolidColorBrush x:Key="Danger.Tint" Color="#FEF2F2" />
          <SolidColorBrush x:Key="Danger.Border" Color="#FECACA" />
          <SolidColorBrush x:Key="Avatar.0.Background" Color="#E8EEF9" />
          <SolidColorBrush x:Key="Avatar.0.Foreground" Color="#34558B" />
          <SolidColorBrush x:Key="Avatar.1.Background" Color="#F5EBDD" />
          <SolidColorBrush x:Key="Avatar.1.Foreground" Color="#795427" />
          <SolidColorBrush x:Key="Avatar.2.Background" Color="#E5F1EC" />
          <SolidColorBrush x:Key="Avatar.2.Foreground" Color="#32654E" />
          <SolidColorBrush x:Key="Avatar.3.Background" Color="#EEE9F7" />
          <SolidColorBrush x:Key="Avatar.3.Foreground" Color="#654B88" />
          <SolidColorBrush x:Key="Avatar.4.Background" Color="#F6E8EC" />
          <SolidColorBrush x:Key="Avatar.4.Foreground" Color="#8B435D" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <BoxShadows x:Key="PopupShadow">0 8 24 0 #73000000</BoxShadows>
          <SolidColorBrush x:Key="Surface.Content" Color="#1B1C1F" />
          <SolidColorBrush x:Key="Surface.Sidebar" Color="#141518" />
          <SolidColorBrush x:Key="Surface.Card" Color="#222428" />
          <SolidColorBrush x:Key="Surface.Aside" Color="#18191C" />
          <SolidColorBrush x:Key="Border" Color="#2E3136" />
          <SolidColorBrush x:Key="Border.Subtle" Color="#26282C" />
          <SolidColorBrush x:Key="Border.Control" Color="#3A3E45" />
          <SolidColorBrush x:Key="Text.Primary" Color="#E8EAED" />
          <SolidColorBrush x:Key="Text.Secondary" Color="#C2C6CE" />
          <SolidColorBrush x:Key="Text.Muted" Color="#9097A3" />
          <SolidColorBrush x:Key="Text.Disabled" Color="#4A4F57" />
          <!-- Same hex as the Dark palette Accent in App.axaml, which Fluent controls read. -->
          <SolidColorBrush x:Key="Accent" Color="#8DA2FB" />
          <SolidColorBrush x:Key="Accent.Text" Color="#B4C3FF" />
          <SolidColorBrush x:Key="Accent.Tint" Color="#262F52" />
          <SolidColorBrush x:Key="Accent.OnSolid" Color="#141518" />
          <SolidColorBrush x:Key="Account.Row" Color="#232B46" />
          <SolidColorBrush x:Key="Guard.Captain.Row" Color="#0B2828" />
          <SolidColorBrush x:Key="Guard.Admiral.Row" Color="#2C1D2B" />
          <SolidColorBrush x:Key="Guard.Governor.Row" Color="#2B210F" />
          <SolidColorBrush x:Key="Guard.Captain.Badge" Color="#004848" />
          <SolidColorBrush x:Key="Guard.Captain.BadgeText" Color="#8BE3E2" />
          <SolidColorBrush x:Key="Guard.Admiral.Badge" Color="#512F50" />
          <SolidColorBrush x:Key="Guard.Admiral.BadgeText" Color="#F0BEEE" />
          <SolidColorBrush x:Key="Guard.Governor.Badge" Color="#503807" />
          <SolidColorBrush x:Key="Guard.Governor.BadgeText" Color="#EFCB91" />
          <SolidColorBrush x:Key="Badge.Neutral" Color="#2E3136" />
          <SolidColorBrush x:Key="Success" Color="#6FD08C" />
          <SolidColorBrush x:Key="Warning.Background" Color="#2A2114" />
          <SolidColorBrush x:Key="Warning.Border" Color="#5A4318" />
          <SolidColorBrush x:Key="Warning.Text" Color="#F2C46D" />
          <SolidColorBrush x:Key="Danger" Color="#F87171" />
          <SolidColorBrush x:Key="Danger.Tint" Color="#321E22" />
          <SolidColorBrush x:Key="Danger.Border" Color="#673238" />
          <SolidColorBrush x:Key="Avatar.0.Background" Color="#25314A" />
          <SolidColorBrush x:Key="Avatar.0.Foreground" Color="#BED2FC" />
          <SolidColorBrush x:Key="Avatar.1.Background" Color="#3B3023" />
          <SolidColorBrush x:Key="Avatar.1.Foreground" Color="#E8CA9F" />
          <SolidColorBrush x:Key="Avatar.2.Background" Color="#223B32" />
          <SolidColorBrush x:Key="Avatar.2.Foreground" Color="#AFDDC5" />
          <SolidColorBrush x:Key="Avatar.3.Background" Color="#332C45" />
          <SolidColorBrush x:Key="Avatar.3.Foreground" Color="#D7C5F4" />
          <SolidColorBrush x:Key="Avatar.4.Background" Color="#402A33" />
          <SolidColorBrush x:Key="Avatar.4.Foreground" Color="#F0BCCD" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- Lucide icons, paths copied from the #84 design; ISC license in ThirdPartyNotices.txt. -->
      <StreamGeometry x:Key="Icon.Danmaku">M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z</StreamGeometry>
      <StreamGeometry x:Key="Icon.BlindBox">M20 12v9H4v-9M2 7h20v5H2zM12 21V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Welcome">M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3</StreamGeometry>
      <StreamGeometry x:Key="Icon.Animation">M4 4h16v16H4zM8 4v16M16 4v16M4 9h4M4 15h4M16 9h4M16 15h4</StreamGeometry>
      <StreamGeometry x:Key="Icon.Play">M7 4l13 8-13 8z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Wave">M3 10v4M7 7v10M11 4v16M15 8v8M19 11v2</StreamGeometry>
      <StreamGeometry x:Key="Icon.Copy">M9 9h11v11H9zM5 15H4V4h11v1</StreamGeometry>
      <StreamGeometry x:Key="Icon.Check">M20 6L9 17l-5-5</StreamGeometry>
      <StreamGeometry x:Key="Icon.Ok">M22 11.08V12a10 10 0 1 1-5.93-9.14M22 4L12 14.01l-3-3</StreamGeometry>
      <StreamGeometry x:Key="Icon.Alert">M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0zM12 9v4M12 17h.01</StreamGeometry>
      <StreamGeometry x:Key="Icon.Fail">M12 22a10 10 0 1 0 0-20a10 10 0 0 0 0 20zM15 9l-6 6M9 9l6 6</StreamGeometry>
      <StreamGeometry x:Key="Icon.Skip">M12 22a10 10 0 1 0 0-20a10 10 0 0 0 0 20zM8 12h8</StreamGeometry>
      <StreamGeometry x:Key="Icon.Clock">M12 22a10 10 0 1 0 0-20a10 10 0 0 0 0 20zM12 6v6l4 2</StreamGeometry>
      <StreamGeometry x:Key="Icon.Info">M12 22a10 10 0 1 0 0-20a10 10 0 0 0 0 20zM12 16v-4M12 8h.01</StreamGeometry>
      <StreamGeometry x:Key="Icon.Add">M12 5v14M5 12h14</StreamGeometry>
      <StreamGeometry x:Key="Icon.Send">M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Settings">M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6</StreamGeometry>
      <StreamGeometry x:Key="Icon.Logout">M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9</StreamGeometry>
      <StreamGeometry x:Key="Icon.Remove">M18 6L6 18M6 6l12 12</StreamGeometry>
      <StreamGeometry x:Key="Icon.Notice">M12 8v5 M12 16v.01 M22 12a10 10 0 1 1-20 0a10 10 0 1 1 20 0</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Surface.Content}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.muted, TextBlock.hint">
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.numeric, TextBox.numeric, ComboBox.numeric, NumericUpDown">
    <Setter Property="TextElement.FontFeatures" Value="tnum" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource Success}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter, Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.Sidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.OnSolid}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter, Button.accent:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.OnSolid}" />
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent.Tint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Tint}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="Button.chip">
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter, Button.danger:pressed /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    <Setter Property="Background" Value="{DynamicResource Danger.Tint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
  </Style>
  <!-- An icon-only danger action stays quiet until hovered. -->
  <Style Selector="Button.ghost.danger">
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
  </Style>
  <Style Selector="Button.listFold">
    <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
  </Style>
  <Style Selector="Button.listFold.danger">
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
  </Style>
  <!-- A text toggle keeps its tone when hovered, as the animation row's file link does. -->
  <Style Selector="Button.listFold:pointerover /template/ ContentPresenter, Button.listFold:pressed /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
  </Style>
  <Style Selector="Button.listFold.danger:pointerover /template/ ContentPresenter, Button.listFold.danger:pressed /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="ToggleSwitch.plain">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleSwitch.plain /template/ ContentPresenter#PART_OnContentPresenter, ToggleSwitch.plain /template/ ContentPresenter#PART_OffContentPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="TextBox, NumericUpDown, ComboBox">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource Surface.Content}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
  </Style>
  <!-- Fluent tops text in a box taller than its default; the 36 above would leave it sitting high. -->
  <Style Selector="TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- An editable ComboBox takes focus in its borderless inner TextBox; ring the whole box, ▾ included, as other inputs do.
       An open list rings it the same way. -->
  <Style Selector="ComboBox[IsEditable=True]:focus-within /template/ Border#Background, ComboBox:dropdownopen /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Surface.Content}" />
  </Style>
  <Style Selector="ComboBox.history[ItemCount=0] /template/ PathIcon#DropDownGlyph">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ComboBox /template/ Popup#PART_Popup">
    <Setter Property="VerticalOffset" Value="4" />
  </Style>
  <!-- :dropdownopen and [IsVisible=True] below always hold while the card shows; as conditional selectors they outrank
       the values Fluent's templates set. -->
  <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BoxShadow" Value="{DynamicResource PopupShadow}" />
    <Setter Property="Margin" Value="{StaticResource PopupShadowSpace}" />
    <Setter Property="Width" Value="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}" />
  </Style>
  <Style Selector="ComboBox:dropdownopen /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter, ComboBoxItem:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="ComboBox.history ComboBoxItem">
    <Setter Property="Padding" Value="10,0,4,0" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter, ComboBoxItem:selected:pointerover /template/ ContentPresenter, ComboBoxItem:selected:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent.Tint}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ComboBox:dropdownopen /template/ Border#HighlightBackground">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ComboBox:not(:disabled) /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
  </Style>
  <Style Selector="ComboBox:dropdownopen /template/ PathIcon#DropDownGlyph">
    <Setter Property="RenderTransform"><RotateTransform Angle="180" /></Setter>
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="ShowButtonSpinner" Value="True" />
    <Setter Property="Width" Value="120" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="NumericUpDown[ShowButtonSpinner=True] /template/ TextBox#PART_TextBox">
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- Conditional selectors override Fluent's template-local sizes and focused TextBox surface. -->
  <Style Selector="NumericUpDown[ShowButtonSpinner=True] /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="NumericUpDown:focus-within[IsReadOnly=False]">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="NumericUpDown.invalid">
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="NumericUpDown[IsReadOnly=True]">
    <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
  </Style>
  <Style Selector="NumericUpDown[IsReadOnly=True] /template/ TextBox#PART_TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
  </Style>
  <Style Selector="NumericUpDown[ShowButtonSpinner=True] /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton">
    <Setter Property="Width" Value="28" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
  </Style>
  <Style Selector="NumericUpDown[ShowButtonSpinner=True] /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton#PART_IncreaseButton">
    <Setter Property="AutomationProperties.Name" Value="{Binding $parent[NumericUpDown].(AutomationProperties.Name), StringFormat={}{0}加 1}" />
  </Style>
  <Style Selector="NumericUpDown[ShowButtonSpinner=True] /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="AutomationProperties.Name" Value="{Binding $parent[NumericUpDown].(AutomationProperties.Name), StringFormat={}{0}减 1}" />
  </Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton:pointerover /template/ ContentPresenter, NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Badge.Neutral}" />
  </Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton:pointerover PathIcon, NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton:pressed PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton:disabled PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="{StaticResource PopupShadowSpace}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter[IsVisible=True] /template/ Border#LayoutRoot">
    <Setter Property="Padding" Value="4" />
    <Setter Property="BoxShadow" Value="{DynamicResource PopupShadow}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter[IsVisible=True] /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="MenuFlyoutPresenter MenuItem">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="MenuFlyoutPresenter MenuItem:selected /template/ Border#PART_LayoutRoot, MenuFlyoutPresenter MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
  </Style>
  <Style Selector="ListBox.nav, ListBox.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="AutoScrollToSelectedItem" Value="False" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="ListBox.plain">
    <Setter Property="Padding" Value="0,8,0,12" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter, ListBox.nav ListBoxItem:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter, ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter, ListBox.nav ListBoxItem:selected:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent.Tint}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="ListBox.plain Border.activityRow">
    <Setter Property="Margin" Value="20,0" />
    <Setter Property="Padding" Value="0,10" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
  </Style>
  <Style Selector="ListBox.aside Border.activityRow">
    <Setter Property="Margin" Value="16,0" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem:nth-last-child(1) Border.activityRow">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem /template/ ContentPresenter, ListBox.plain ListBoxItem:selected /template/ ContentPresenter, ListBox.plain ListBoxItem:pointerover /template/ ContentPresenter, ListBox.plain ListBoxItem:pressed /template/ ContentPresenter, ListBox.plain ListBoxItem:selected:pointerover /template/ ContentPresenter, ListBox.plain ListBoxItem:selected:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.qr">
    <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="BoxShadow" Value="{DynamicResource QrShadow}" />
  </Style>
  <Style Selector="Border.pageHeader">
    <Setter Property="Height" Value="60" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.notice">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.notice.warning">
    <Setter Property="Background" Value="{DynamicResource Warning.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Warning.Border}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Warning.Text}" />
  </Style>
  <Style Selector="Border.notice.error">
    <Setter Property="Background" Value="{DynamicResource Danger.Tint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger.Border}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="TextElement.FontSize" Value="11" />
  </Style>
  <Style Selector="Border.captain">
    <Setter Property="Background" Value="{DynamicResource Guard.Captain.Row}" />
  </Style>
  <Style Selector="Border.admiral">
    <Setter Property="Background" Value="{DynamicResource Guard.Admiral.Row}" />
  </Style>
  <Style Selector="Border.governor">
    <Setter Property="Background" Value="{DynamicResource Guard.Governor.Row}" />
  </Style>
  <!-- Account rows take precedence over every guard tier. -->
  <Style Selector="Border.account">
    <Setter Property="Background" Value="{DynamicResource Account.Row}" />
  </Style>
  <Style Selector="Border.badge.accountBadge">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent.OnSolid}" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.badge.guardBadge">
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.captain Border.guardBadge">
    <Setter Property="Background" Value="{DynamicResource Guard.Captain.Badge}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Guard.Captain.BadgeText}" />
  </Style>
  <Style Selector="Border.admiral Border.guardBadge">
    <Setter Property="Background" Value="{DynamicResource Guard.Admiral.Badge}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Guard.Admiral.BadgeText}" />
  </Style>
  <Style Selector="Border.governor Border.guardBadge">
    <Setter Property="Background" Value="{DynamicResource Guard.Governor.Badge}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Guard.Governor.BadgeText}" />
  </Style>
  <Style Selector="Border.badge.neutralBadge">
    <Setter Property="Background" Value="{DynamicResource Badge.Neutral}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.sendStatus">
    <Setter Property="TextElement.FontFeatures" Value="tnum" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.sendStatus.sent">
    <Setter Property="Foreground" Value="{DynamicResource Success}" />
  </Style>
  <Style Selector="TextBlock.sendStatus.unsent">
    <Setter Property="Foreground" Value="{DynamicResource Warning.Text}" />
  </Style>
  <Style Selector="Ellipse.status">
    <Setter Property="Fill" Value="{DynamicResource Text.Muted}" />
  </Style>
  <Style Selector="Ellipse.status.connected">
    <Setter Property="Fill" Value="{DynamicResource Success}" />
  </Style>
  <Style Selector="TextBlock.connection">
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextElement.FontFeatures" Value="tnum" />
  </Style>
  <Style Selector="TextBlock.connection.connected">
    <Setter Property="Foreground" Value="{DynamicResource Success}" />
  </Style>
  <!-- Like the design's <svg width="18" viewBox="0 0 24 24">: the 24-unit icon box and its stroke scale down together. -->
  <Style Selector="Viewbox.icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Viewbox.icon.remove">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector="Viewbox.icon > Path">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
  </Style>
</Styles>
