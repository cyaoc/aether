<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aether.Gui.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <x:String x:Key="SettingsReadOnlyHint">这项是多行写法，请在设置文件里改</x:String>
    <x:String x:Key="AnimationVideosReadOnlyHint">这些映射不能逐行编辑，请在设置文件里改</x:String>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#3358D4" />
        <ColorPaletteResources x:Key="Dark" Accent="#8DA2FB" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Aether.Gui/Theme.axaml" />
    <StyleInclude Source="avares://Aether.Gui/SettingsPage.axaml" />
    <Style Selector=":is(Window)">
      <Setter Property="Icon" Value="avares://Aether.Gui/Assets/aether.ico" />
    </Style>
  </Application.Styles>
</Application>
