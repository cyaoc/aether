<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>../../docs/design/app-icon/aether.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="../../docs/design/app-icon/aether.ico" Link="Assets/aether.ico" />
    <AvaloniaResource Include="../../docs/design/app-icon/aether.icns" Link="Assets/aether.icns" />
    <None Update="ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../Aether.Core/Aether.Core.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="YamlDotNet" />
    <InternalsVisibleTo Include="Aether.Gui.Tests" />
    <!-- Auto-update downloads the package this program was published as (ADR 0015); a dotnet build has no RID and never updates. -->
    <AssemblyMetadata Include="RuntimeIdentifier" Value="$(RuntimeIdentifier)" />
    <AssemblyMetadata Include="SelfContained" Value="$(SelfContained)" />
  </ItemGroup>
  <!-- SkiaSharp 3.119.2+ and HarfBuzzSharp ship their Windows native .pdb as native assets; dropping them here also keeps them out of
       deps.json, which would fail startup if the files were deleted after publish. Remove once mono/SkiaSharp#4165 is fixed. -->
  <Target Name="RemoveSkiaAndHarfBuzzNativePdbs" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
        Condition="'%(Extension)' == '.pdb' And ($([System.String]::Copy('%(NuGetPackageId)').StartsWith('SkiaSharp.NativeAssets.')) Or $([System.String]::Copy('%(NuGetPackageId)').StartsWith('HarfBuzzSharp.NativeAssets.')))" />
    </ItemGroup>
  </Target>
</Project>
