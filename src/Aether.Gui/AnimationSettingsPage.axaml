<local:SettingsPage xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Aether.Gui" x:DataType="local:MainWindowViewModel" x:Class="Aether.Gui.AnimationSettingsPage">

  <local:SettingsPage.Styles>
    <Style Selector="Button#FileButton">
      <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
    </Style>
    <Style Selector="Button#FileButton:pointerover /template/ ContentPresenter, Button#FileButton:pressed /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
    </Style>
    <Style Selector="Button#FileButton.missing">
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>
    <Style Selector="Button#FileButton.missing:pointerover /template/ ContentPresenter, Button#FileButton.missing:pressed /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>
    <Style Selector="Button#FileButton.unchosen">
      <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
    </Style>
    <Style Selector="Button#TestButton">
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style Selector="Button#TestButton.playing /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent.Tint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Tint}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
    </Style>
    <Style Selector="Button#TestButton.stoppable /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Grid#RowNote">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Text.Muted}" />
    </Style>
    <Style Selector="Grid#RowNote.error">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Danger}" />
    </Style>
    <Style Selector="Grid#RowNote.playing">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent.Text}" />
    </Style>
  </local:SettingsPage.Styles>
  <local:SettingsPage.HeaderContent>
    <StackPanel VerticalAlignment="Center">
      <ToggleSwitch Classes="plain" x:Name="AnimationInput" AutomationProperties.Name="欢迎动画" />
    </StackPanel>
  </local:SettingsPage.HeaderContent>
  <local:SettingsPage.BodyContent>
    <StackPanel Spacing="10">
      <TextBlock x:Name="AnimationReadOnly" Classes="hint" Text="{StaticResource SettingsReadOnlyHint}" />
      <local:VideoPageStatusBar x:Name="PageStatus" />
      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Margin="0,8">
        <TextBlock Classes="section" Text="按粉丝团等级播放" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" x:Name="FanClubInput" Width="125" AutomationProperties.Name="粉丝团等级门槛" />
        <TextBlock Grid.Column="2" x:Name="FanClubHint" Classes="hint" TextWrapping="Wrap" VerticalAlignment="Center" />
      </Grid>
      <TextBlock x:Name="FanClubReadOnly" Classes="hint" Text="{StaticResource SettingsReadOnlyHint}" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <local:AnimationTestBar x:Name="TestBar" />
        <Slider Grid.Column="1" x:Name="VolumeInput" Classes="volume" VerticalAlignment="Bottom" AutomationProperties.Name="动画音量" />
      </Grid>
      <TextBlock x:Name="VolumeReadOnly" Classes="hint" Text="{StaticResource SettingsReadOnlyHint}" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,12,0,0">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Classes="section" Text="指定观众" Margin="0,0,8,0" />
          <TextBlock Grid.Column="1" Classes="hint" Text="指定的优先于粉丝团等级；选不播，进场时不播" />
        </Grid>
        <TextBlock Grid.Column="1" x:Name="AnimationCount" Classes="caption muted numeric" VerticalAlignment="Center" />
      </Grid>
      <Border x:Name="AnimationRowsBorder" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8">
        <ItemsControl x:Name="AnimationRows" Classes="editableRows dividedRows" ClipToBounds="False">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:AnimationViewerRow">
              <local:EditableRowFrame BorderBrush="{DynamicResource Border.Subtle}" Padding="12,8,6,8">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="104,32,104,*,Auto,30" ColumnSpacing="8">
                    <TextBox x:Name="UidInput" Classes="numeric rowFocus" Text="{Binding UidText, Mode=TwoWay}" IsReadOnly="{Binding !CanEdit}" Classes.invalid="{Binding VisibleError, Converter={x:Static ObjectConverters.IsNotNull}}" Height="32" MinHeight="32" FontSize="13" PlaceholderText="输入 UID" AutomationProperties.Name="观众 UID" />
                    <local:OnlineRankPicker Grid.Column="1" x:Name="OnlinePicker" Target="{Binding #UidInput}" Host="{Binding $parent[local:AnimationSettingsPage].DataContext}" AccessibleName="{Binding Number, StringFormat=从在线榜选第 {0} 位观众}" FillTargetText="这一行" DisabledReason="{StaticResource AnimationViewersReadOnlyHint}" />
                    <ComboBox Grid.Column="2" ItemsSource="{x:Static local:AnimationViewerRow.Choices}" ItemTemplate="{x:Static local:AnimationViewerRow.ChoiceTemplate}" SelectedItem="{Binding Choice, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="进场播什么" />
                    <Button Grid.Column="3" x:Name="FileButton" IsVisible="{Binding IsVideo}" Command="{Binding $parent[local:AnimationSettingsPage].ChooseAnimationAsync}" CommandParameter="{Binding}" IsEnabled="{Binding CanEdit}" Classes.missing="{Binding Missing}" Classes.unchosen="{Binding !HasFile}" ToolTip.Tip="点击更换视频" AutomationProperties.Name="{Binding FileAccessibleName}" Classes="ghost" Height="32" Padding="8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Viewbox Classes="icon" Width="16" Height="16"><Path x:Name="FileIcon" Data="{Binding FileIcon}" /></Viewbox>
                        <TextBlock Grid.Column="1" x:Name="FileNameText" Text="{Binding FileText}" TextDecorations="{Binding FileNameDecorations}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                    <Button Grid.Column="4" x:Name="TestButton" IsVisible="{Binding IsVideo}" Command="{Binding $parent[local:AnimationSettingsPage].TestAnimation}" CommandParameter="{Binding}" IsEnabled="{Binding CanTest}" Classes.playing="{Binding Playing}" Classes.stoppable="{Binding Stoppable}" AutomationProperties.Name="{Binding TestAccessibleName}" Height="30" MinHeight="30" Padding="8,0,10,0">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Viewbox Classes="icon" Width="14" Height="14"><Path x:Name="TestIcon" Data="{Binding TestIcon}" StrokeThickness="2" /></Viewbox>
                        <TextBlock x:Name="TestText" Text="{Binding TestText}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="5" x:Name="RemoveButton" Command="{Binding Remove}" IsEnabled="{Binding CanRemove}" IsVisible="{Binding CanEdit}" AutomationProperties.Name="{Binding RemoveAccessibleName}" Classes="ghost danger" Width="30" Height="30">
                      <Viewbox Classes="icon" Width="16" Height="16"><Path Data="{StaticResource Icon.Remove}" /></Viewbox>
                    </Button>
                  </Grid>
                  <Grid x:Name="RowNote" IsVisible="{Binding RowMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Classes.error="{Binding NoteError}" Classes.playing="{Binding NotePlaying}" ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="2,0,0,0">
                    <Viewbox Classes="icon" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0"><Path x:Name="NoteIcon" Data="{Binding NoteIcon}" StrokeThickness="2" /></Viewbox>
                    <TextBlock Grid.Column="1" x:Name="RowMessage" Text="{Binding RowMessage}" FontSize="12" LineHeight="18" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                  </Grid>
                </StackPanel>
              </local:EditableRowFrame>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <Grid x:Name="EmptyAnimations">
        <Rectangle Stroke="{DynamicResource Border.Control}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="8" RadiusY="8" />
        <StackPanel Margin="16,22" Spacing="4" HorizontalAlignment="Center">
          <TextBlock Classes="label" Text="还没有观众" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Classes="caption muted singleLine" Text="点下面的“添加观众”，填上 UID 并指定进场时播什么。" TextAlignment="Center" LineHeight="18" />
        </StackPanel>
      </Grid>
      <TextBlock x:Name="AnimationViewersReadOnly" Classes="hint" IsVisible="False" Text="{StaticResource AnimationViewersReadOnlyHint}" />
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Button x:Name="AddAnimationButton" HorizontalAlignment="Left" Padding="10,0,12,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Viewbox Classes="icon" Width="16" Height="16"><Path Data="{StaticResource Icon.Add}" /></Viewbox>
            <TextBlock Text="添加观众" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Grid.Column="1" Classes="caption muted singleLine" Text="选欢迎动画时挑一个 MP4 或 WebM，保存时复制到数据目录" VerticalAlignment="Center" />
      </Grid>
    </StackPanel>
  </local:SettingsPage.BodyContent>
  <local:SettingsPage.ActivityContent>
    <local:RecentPlaybackList ItemsSource="{Binding WebService.RecentEntryAnimations}" />
  </local:SettingsPage.ActivityContent>
</local:SettingsPage>
