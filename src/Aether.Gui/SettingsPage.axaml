<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Aether.Gui" xmlns:core="clr-namespace:Aether.Core;assembly=Aether.Core" x:DataType="local:MainWindowViewModel" x:Class="Aether.Gui.SettingsPage">
  <UserControl.Resources>
    <DataTemplate x:Key="AnimationActivityTemplate" x:DataType="local:WelcomeAnimationItem">
      <Border Classes="activityRow">
        <StackPanel Spacing="4">
          <local:ActivityHeader>
            <TextBlock Classes="secondary" TextWrapping="Wrap"><Run Text="{Binding Name}" FontWeight="SemiBold" /><Run Text="{Binding Detail, StringFormat=' {0}', TargetNullValue=''}" Foreground="{DynamicResource Text.Muted}" FontFeatures="tnum" /></TextBlock>
            <TextBlock Classes="caption muted numeric" Text="{Binding OccurredAt, StringFormat={}{0:HH:mm:ss}}" />
          </local:ActivityHeader>
          <TextBlock Classes="label" Text="{Binding Playback.FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Playback.FileName}" />
          <Grid Classes="playbackStatus" Classes.playing="{Binding Playing}" Classes.completed="{Binding Completed}" Classes.failed="{Binding Failed}"
            Classes.unplayed="{Binding Unplayed}" Classes.skipped="{Binding RecentlyPlayed}" ColumnDefinitions="Auto,*" ColumnSpacing="5">
            <Viewbox Classes="icon" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0"><Path StrokeThickness="2" /></Viewbox>
            <TextBlock Grid.Column="1" x:Name="PlaybackStatus" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="FeatureActivityTemplate" x:DataType="local:SendQueueItemViewModel">
      <Border Classes="activityRow">
        <StackPanel Spacing="4">
          <local:ActivityHeader>
            <TextBlock Classes="secondary" TextWrapping="Wrap"><Run Text="{Binding Nickname}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Detail}" Foreground="{DynamicResource Text.Muted}" /></TextBlock>
            <TextBlock Classes="caption muted numeric" Text="{Binding OccurredAt, StringFormat={}{0:HH:mm:ss}}" />
          </local:ActivityHeader>
          <TextBlock Classes="label" Text="{Binding TextOrPlaceholder}" TextWrapping="Wrap" />
          <TextBlock Classes="sendStatus" Classes.sent="{Binding IsSent}" Classes.unsent="{Binding IsUnsent}" Text="{Binding Status}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="SendActivityTemplate" x:DataType="local:SendQueueItemViewModel">
      <Border Classes="activityRow">
        <StackPanel Spacing="4">
          <local:ActivityHeader>
            <TextBlock Classes="secondary" TextWrapping="Wrap"><Run Text="{Binding Nickname}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding KindText}" Foreground="{DynamicResource Text.Muted}" /></TextBlock>
            <TextBlock Classes="caption muted numeric" Text="{Binding OccurredAt, StringFormat={}{0:HH:mm:ss}}" />
          </local:ActivityHeader>
          <TextBlock Classes="label" Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="sendStatus" Classes.sent="{Binding IsSent}" Classes.unsent="{Binding IsUnsent}" Text="{Binding Status}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- 最近播放: one tone and icon per playback state, as on canvas I1. -->
    <Style Selector="Grid.playbackStatus">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent.Text}" />
    </Style>
    <Style Selector="Grid.playbackStatus Path">
      <Setter Property="Data" Value="{StaticResource Icon.Clock}" />
    </Style>
    <Style Selector="Grid.playbackStatus.playing Path">
      <Setter Property="Data" Value="{StaticResource Icon.Wave}" />
    </Style>
    <Style Selector="Grid.playbackStatus.completed">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Success}" />
    </Style>
    <Style Selector="Grid.playbackStatus.completed Path">
      <Setter Property="Data" Value="{StaticResource Icon.Check}" />
    </Style>
    <Style Selector="Grid.playbackStatus.failed">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Danger}" />
    </Style>
    <Style Selector="Grid.playbackStatus.failed Path">
      <Setter Property="Data" Value="{StaticResource Icon.Fail}" />
    </Style>
    <Style Selector="Grid.playbackStatus.unplayed">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Warning.Text}" />
    </Style>
    <Style Selector="Grid.playbackStatus.unplayed Path">
      <Setter Property="Data" Value="{StaticResource Icon.Alert}" />
    </Style>
    <Style Selector="Grid.playbackStatus.skipped">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Text.Muted}" />
    </Style>
    <Style Selector="Grid.playbackStatus.skipped Path">
      <Setter Property="Data" Value="{StaticResource Icon.Skip}" />
    </Style>
    <Style Selector="StackPanel#CopyContent.copied">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Success}" />
    </Style>
    <Style Selector="TextBox.address">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontFamily" Value="Menlo, Consolas" />
      <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="60,Auto,*">
    <Border Classes="pageHeader">
      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
        <TextBlock x:Name="PageTitle" Classes="h1" VerticalAlignment="Center" />
        <Panel Grid.Column="1" IsEnabled="{Binding !#FileMessage.IsVisible}">
          <StackPanel x:Name="BlindBoxHeader" VerticalAlignment="Center">
            <ToggleSwitch Classes="plain" x:Name="BlindBoxInput" AutomationProperties.Name="记录盲盒" />
          </StackPanel>
          <StackPanel x:Name="WelcomeHeader" VerticalAlignment="Center">
            <ToggleSwitch Classes="plain" x:Name="WelcomeInput" AutomationProperties.Name="进场欢迎" />
          </StackPanel>
          <StackPanel x:Name="AnimationHeader" VerticalAlignment="Center">
            <ToggleSwitch Classes="plain" x:Name="AnimationInput" AutomationProperties.Name="欢迎动画" />
          </StackPanel>
        </Panel>
        <TextBlock Grid.Column="2" x:Name="TimingHint" Classes="caption muted" VerticalAlignment="Center" TextWrapping="Wrap" />
      </Grid>
    </Border>
    <StackPanel Grid.Row="1">
      <Border Classes="notice error" Margin="20,14,20,0" IsVisible="{Binding #FileMessage.IsVisible}">
        <Grid ColumnDefinitions="18,*" ColumnSpacing="10">
          <Viewbox Classes="icon"><Path Data="{StaticResource Icon.Notice}" Stroke="{DynamicResource Danger}" /></Viewbox>
          <TextBlock Grid.Column="1" x:Name="FileMessage" Classes="secondary" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </Grid>
      </Border>
      <Border x:Name="ReconnectNotice" Classes="notice warning" IsVisible="False" Margin="20,14,20,0">
        <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="10">
          <Viewbox Classes="icon"><Path Data="{StaticResource Icon.Notice}" Stroke="{DynamicResource Warning.Text}" /></Viewbox>
          <TextBlock Grid.Column="1" Classes="secondary" Text="已保存。当前连接还在用旧设置，重新连接后生效。" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" x:Name="ReconnectButton" Content="重新连接" Command="{Binding ReconnectCommand}" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <StackPanel IsVisible="{Binding #BlindBoxHeader.IsVisible}" Margin="20,0">
        <TextBlock x:Name="BlindBoxReadOnly" Classes="hint" Text="这项是多行写法，请在设置文件里改" />
        <TextBlock x:Name="BlindBoxError" Classes="error" />
      </StackPanel>
      <StackPanel IsVisible="{Binding #WelcomeHeader.IsVisible}" Margin="20,0">
        <TextBlock x:Name="WelcomeReadOnly" Classes="hint" Text="这项是多行写法，请在设置文件里改" />
        <TextBlock x:Name="WelcomeError" Classes="error" />
      </StackPanel>
    </StackPanel>
    <Grid Grid.Row="2" x:Name="PageLayout" ColumnDefinitions="*,Auto" RowDefinitions="*,0">
      <Grid RowDefinitions="*,Auto">
        <Grid x:Name="FieldsAndSendActivity" RowDefinitions="*,0">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="20,18">
            <StackPanel>
              <StackPanel x:Name="GeneralFields" Spacing="8">
                <TextBlock Classes="label" Text="日志保留" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <NumericUpDown x:Name="RetentionInput" Minimum="1" Classes.invalid="{Binding #RetentionError.IsVisible}" FormatString="0.############################" AutomationProperties.Name="日志保留天数" />
                  <TextBlock Classes="label" Text="天" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="RetentionReadOnly" Classes="hint" Text="这项是多行写法，请在设置文件里改" />
                <TextBlock x:Name="RetentionError" Classes="error" />
                <TextBlock Classes="label" Text="级别" Margin="0,8,0,0" />
                <ComboBox x:Name="LogLevelInput" Width="200" HorizontalAlignment="Left" AutomationProperties.Name="日志级别" />
                <TextBlock x:Name="LogLevelReadOnly" Classes="hint" Text="这项是多行写法，请在设置文件里改" />
                <TextBlock x:Name="LogLevelError" Classes="error" />
                <Button Content="打开设置文件" Click="OpenFile" />
                <TextBlock x:Name="UnknownKeysMessage" Classes="hint" />
              </StackPanel>
              <StackPanel x:Name="BlindBoxFields" Spacing="8">
                <TextBlock Classes="label" Text="今日查询关键字" />
                <TextBox x:Name="DailyKeywordInput" Width="240" HorizontalAlignment="Left" AutomationProperties.Name="今日查询关键字" />
                <TextBlock x:Name="DailyKeywordReadOnly" Classes="hint" Text="这项是多行写法，请在设置文件里改" />
                <TextBlock x:Name="DailyKeywordError" Classes="error" />
                <TextBlock Classes="label" Text="本月查询关键字" Margin="0,8,0,0" />
                <TextBox x:Name="MonthlyKeywordInput" Width="240" HorizontalAlignment="Left" AutomationProperties.Name="本月查询关键字" />
                <TextBlock x:Name="MonthlyKeywordReadOnly" Classes="hint" Text="这项是多行写法，请在设置文件里改" />
                <TextBlock x:Name="MonthlyKeywordError" Classes="error" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,10,0,0" IsEnabled="{Binding !#FileMessage.IsVisible}">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="盲盒播报" />
                    <TextBlock Classes="hint" Text="观众送完一轮盲盒后，自动播报这一轮的盈亏。" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" Classes="plain" x:Name="AnnounceInput" AutomationProperties.Name="盲盒播报" />
                </Grid>
                <TextBlock x:Name="AnnounceReadOnly" Classes="hint" Text="这项是多行写法，请在设置文件里改" />
                <TextBlock x:Name="AnnounceError" Classes="error" />
              </StackPanel>
              <StackPanel x:Name="AnimationFields" Spacing="10">
                <TextBlock x:Name="AnimationReadOnly" Classes="hint" Text="这项是多行写法，请在设置文件里改" />
                <WrapPanel>
                  <TextBlock Classes="section" Text="动画页" Margin="0,0,8,0" />
                  <TextBlock Classes="hint" Text="直播姬里的浏览器素材显示这个网页" />
                </WrapPanel>
                <Border Classes="card notice" Classes.warning="{Binding ShowAnimationSetup}" Classes.error="{Binding HasAnimationError}">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <Panel VerticalAlignment="Top" Margin="0,1,0,0">
                        <Viewbox Classes="icon" Width="16" Height="16" IsVisible="{Binding HasAnimationPages}"><Path Data="{StaticResource Icon.Ok}" Stroke="{DynamicResource Success}" StrokeThickness="2" /></Viewbox>
                        <Viewbox Classes="icon" Width="16" Height="16" IsVisible="{Binding ShowAnimationSetup}"><Path Data="{StaticResource Icon.Alert}" StrokeThickness="2" /></Viewbox>
                        <Viewbox Classes="icon" Width="16" Height="16" IsVisible="{Binding HasAnimationError}"><Path Data="{StaticResource Icon.Fail}" StrokeThickness="2" /></Viewbox>
                        <Viewbox Classes="icon" Width="16" Height="16" IsVisible="{Binding IsAnimationPageOff}"><Path Data="{StaticResource Icon.Info}" Stroke="{DynamicResource Text.Muted}" StrokeThickness="2" /></Viewbox>
                      </Panel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="AnimationPageStatusText" Classes="secondary" Classes.success="{Binding HasAnimationPages}" Classes.muted="{Binding IsAnimationPageOff}" FontWeight="SemiBold" Text="{Binding AnimationPageText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="AnimationPageHelpText" Classes="caption" Foreground="{DynamicResource Text.Secondary}" LineHeight="18" Text="{Binding AnimationPageHelp}" TextWrapping="Wrap"
                          IsVisible="{Binding AnimationPageHelp, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox x:Name="AnimationAddress" Classes="address" Text="{Binding AnimationAddressText, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="动画页地址" />
                      <Button Grid.Column="1" x:Name="CopyAnimationAddressButton" Height="32" Padding="10,0,12,0" AutomationProperties.Name="复制动画页地址">
                        <StackPanel x:Name="CopyContent" Orientation="Horizontal" Spacing="6">
                          <Viewbox Classes="icon" Width="14" Height="14"><Path x:Name="CopyIcon" Data="{StaticResource Icon.Copy}" StrokeThickness="2" /></Viewbox>
                          <TextBlock x:Name="CopyText" Text="复制" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </StackPanel>
                </Border>
                <TextBlock Classes="label" Text="端口" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <NumericUpDown x:Name="AnimationPortInput" Minimum="1" Maximum="65535" Classes.invalid="{Binding #AnimationPortError.IsVisible}" FormatString="0.############################" AutomationProperties.Name="动画页端口" />
                  <TextBlock Classes="caption muted" Text="被占用时换一个，直播姬里的地址也要跟着改" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="AnimationPortReadOnly" Classes="hint" Text="这项是多行写法，请在设置文件里改" />
                <TextBlock x:Name="AnimationPortError" Classes="error" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                  <WrapPanel>
                    <TextBlock Classes="section" Text="观众" Margin="0,0,8,0" />
                    <TextBlock Classes="hint" Text="进场时在直播画面上播放各自的视频" />
                  </WrapPanel>
                  <TextBlock Grid.Column="1" x:Name="AnimationCount" Classes="caption muted numeric" VerticalAlignment="Center" />
                </Grid>
                <Border x:Name="AnimationRowsBorder" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8">
                  <StackPanel x:Name="AnimationRows" />
                </Border>
                <Grid x:Name="EmptyAnimations">
                  <Rectangle Stroke="{DynamicResource Border.Control}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="8" RadiusY="8" />
                  <StackPanel Margin="16,22" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Classes="label" Text="还没有观众" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Classes="caption muted" Text="点下面的“添加观众”，选一个视频、填上 UID，这位观众进场时就会播放。" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18" />
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="AnimationVideosReadOnly" Classes="hint" IsVisible="False" Text="这些映射不能逐行编辑，请在设置文件里改" />
                <WrapPanel>
                  <Button x:Name="AddAnimationButton" HorizontalAlignment="Left" Padding="10,0,12,0" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Viewbox Classes="icon" Width="16" Height="16"><Path Data="{StaticResource Icon.Add}" /></Viewbox>
                      <TextBlock Text="添加观众" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <TextBlock Classes="caption muted" Text="选 MP4 或 WebM，保存时复制到数据目录" VerticalAlignment="Center" />
                </WrapPanel>
              </StackPanel>
              <StackPanel x:Name="SendFields" Spacing="8">
                <TextBlock Classes="label" Text="发送间隔" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <NumericUpDown x:Name="SendIntervalInput" Minimum="1" Classes.invalid="{Binding #SendIntervalError.IsVisible}" FormatString="0.############################" AutomationProperties.Name="发送间隔秒数" />
                  <TextBlock Classes="label" Text="秒" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="SendIntervalReadOnly" Classes="hint" Text="这项是多行写法，请在设置文件里改" />
                <TextBlock x:Name="SendIntervalError" Classes="error" />
              </StackPanel>
              <StackPanel x:Name="WelcomeFields" Spacing="8">
                <TextBlock Classes="section" Text="欢迎语" />
                <TextBox x:Name="WelcomeTextInput" AutomationProperties.Name="欢迎语" />
                <TextBlock x:Name="WelcomeTextReadOnly" Classes="hint" Text="这项是多行写法，请在设置文件里改" />
                <TextBlock x:Name="WelcomeTextError" Classes="error" />
                <WrapPanel Orientation="Horizontal">
                  <TextBlock Classes="caption muted" Text="插入" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <Button Classes="chip" Margin="0,0,6,0" x:Name="InsertAtButton" Content="@观众" Tag="{}{@}" Click="InsertPlaceholder" />
                  <Button Classes="chip" Margin="0,0,6,0" x:Name="InsertNicknameButton" Content="昵称" Tag="{}{昵称}" Click="InsertPlaceholder" />
                  <Button Classes="chip" Margin="0,0,6,0" x:Name="InsertGuardButton" Content="大航海身份" Tag="{}{大航海}" Click="InsertPlaceholder" />
                </WrapPanel>
                <TextBlock x:Name="WelcomeTextHint" Classes="caption muted" TextWrapping="Wrap"
                  Text="英文、数字、半角符号算 1，其他字符算 2。上限自动读取账号的。可用 {@}（只能放开头）、{昵称}、{大航海}；用 {{ 和 }} 转义花括号。" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                  <WrapPanel>
                    <TextBlock Classes="section" Text="欢迎条件" Margin="0,0,10,0" />
                    <TextBlock Classes="hint" Text="满足任意一条就欢迎" />
                  </WrapPanel>
                  <TextBlock Grid.Column="1" x:Name="ConditionCount" Classes="caption muted numeric" VerticalAlignment="Center" />
                </Grid>
                <StackPanel x:Name="ConditionRows" />
                <Grid x:Name="EmptyConditions">
                  <Rectangle Stroke="{DynamicResource Border.Control}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="8" RadiusY="8" />
                  <StackPanel Margin="18" Spacing="6">
                    <TextBlock Classes="label" Text="还没有欢迎条件" FontWeight="SemiBold" />
                    <TextBlock Classes="hint" Text="现在不会欢迎任何人。点下面的“添加条件”，选要欢迎哪些观众。" />
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="ConditionsReadOnly" Classes="hint" TextWrapping="Wrap" />
                <Button x:Name="AddConditionButton" Content="＋ 添加条件" HorizontalAlignment="Left">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                      <MenuItem Tag="{x:Static core:WelcomeCondition.Uid}" Click="AddConditionFromMenu" AutomationProperties.Name="添加指定观众条件">
                        <MenuItem.Header>
                          <StackPanel Spacing="3" Margin="0,3">
                            <TextBlock Classes="label" Text="指定观众" />
                            <TextBlock Classes="caption muted" Text="按 UID 欢迎，可以添加多条" />
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="{x:Static core:WelcomeCondition.FanClubLevel}" Click="AddConditionFromMenu" AutomationProperties.Name="添加粉丝团等级条件">
                        <MenuItem.Header>
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,3">
                            <StackPanel Spacing="3">
                              <TextBlock Classes="label" Text="粉丝团等级" />
                              <TextBlock Classes="caption muted" Text="本直播间粉丝团达到某一级" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="FanClubAdded" Classes="caption muted" Text="已添加" VerticalAlignment="Center" />
                          </Grid>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="{x:Static core:WelcomeCondition.Guard}" Click="AddConditionFromMenu" AutomationProperties.Name="添加大航海身份条件">
                        <MenuItem.Header>
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,3">
                            <StackPanel Spacing="3">
                              <TextBlock Classes="label" Text="大航海身份" />
                              <TextBlock Classes="caption muted" Text="舰长、提督或总督，含更高身份" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="GuardAdded" Classes="caption muted" Text="已添加" VerticalAlignment="Center" />
                          </Grid>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="{x:Static core:WelcomeCondition.WealthLevel}" Click="AddConditionFromMenu" AutomationProperties.Name="添加荣耀等级条件">
                        <MenuItem.Header>
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,3">
                            <StackPanel Spacing="3">
                              <TextBlock Classes="label" Text="荣耀等级" />
                              <TextBlock Classes="caption muted" Text="全站荣耀等级达到某一级" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="WealthAdded" Classes="caption muted" Text="已添加" VerticalAlignment="Center" />
                          </Grid>
                        </MenuItem.Header>
                      </MenuItem>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <Grid x:Name="SendActivity" Grid.Row="1" RowDefinitions="Auto,*">
            <Grid x:Name="PendingActivity" RowDefinitions="Auto,*">
              <Grid ColumnDefinitions="*,Auto" Margin="20,0,20,2">
                <TextBlock Text="待发" Classes="section" />
                <TextBlock Grid.Column="1" Classes="caption muted numeric" Text="{Binding PendingSends.Count, StringFormat={}{0:N0} 条}" />
              </Grid>
              <Panel Grid.Row="1">
                <TextBlock Classes="hint" Text="暂无待发弹幕" Margin="20,8,20,12" IsVisible="{Binding !PendingSends.Count}" />
                <ListBox x:Name="PendingSendsList" Classes="plain" ItemsSource="{Binding PendingSends}" ItemTemplate="{StaticResource SendActivityTemplate}" AutomationProperties.Name="待发弹幕" IsVisible="{Binding !!PendingSends.Count}" />
              </Panel>
            </Grid>
            <Grid x:Name="RecentSendsActivity" Grid.Row="1" RowDefinitions="Auto,*" Margin="0,12,0,0">
              <Grid x:Name="RecentSendsHeader" ColumnDefinitions="*,Auto" Margin="20,0,20,2">
                <TextBlock Text="最近发送" Classes="section" />
                <TextBlock Grid.Column="1" Classes="caption muted numeric" Text="{Binding RecentSends.Count, StringFormat={}{0:N0} 条}" />
              </Grid>
              <Panel Grid.Row="1">
                <TextBlock Classes="hint" Text="暂无发送记录" Margin="20,8,20,12" IsVisible="{Binding !RecentSends.Count}" />
                <ListBox x:Name="RecentSendsList" Classes="plain" ItemsSource="{Binding RecentSends}" ItemTemplate="{StaticResource SendActivityTemplate}" AutomationProperties.Name="最近发送" IsVisible="{Binding !!RecentSends.Count}" />
              </Panel>
            </Grid>
          </Grid>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="20,12,20,18">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <TextBlock Classes="caption muted" Text="没有未保存的修改" IsVisible="{Binding !#DirtyMessage.IsVisible}" />
              <TextBlock x:Name="DirtyMessage" Classes="caption accent" Text="有未保存的修改" />
              <TextBlock x:Name="Message" Classes="caption" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" IsVisible="{Binding #Message.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="SaveButton" Content="保存" Classes="accent" MinWidth="80" Height="34" Click="Save" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>
      <Border x:Name="RecentActivity" Grid.Column="1" Width="300" Background="{DynamicResource Surface.Aside}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="16,18,16,2">
            <TextBlock x:Name="RecentActivityTitle" Classes="section" />
            <Panel Grid.Column="1">
              <TextBlock x:Name="WelcomeTotal" Classes="caption muted numeric" Text="{Binding WelcomeCount, StringFormat=共 {0:N0} 次}" VerticalAlignment="Center" />
              <Panel IsVisible="{Binding #RecentAnimationsList.IsVisible}">
                <TextBlock x:Name="AnimationTotal" Classes="caption muted numeric" Text="{Binding RecentAnimations.Count, StringFormat=共 {0:N0} 次}" IsVisible="{Binding !!RecentAnimations.Count}" VerticalAlignment="Center" />
              </Panel>
              <TextBlock Classes="caption muted numeric" Text="{Binding RecentQueriesAndAnnouncements.Count, StringFormat={}{0:N0} 条}" IsVisible="{Binding #RecentQueriesAndAnnouncementsList.IsVisible}" VerticalAlignment="Center" />
            </Panel>
          </Grid>
          <Panel Grid.Row="1">
            <ListBox x:Name="RecentWelcomesList" Classes="plain aside" ItemsSource="{Binding RecentWelcomes}" ItemTemplate="{StaticResource FeatureActivityTemplate}" AutomationProperties.Name="最近欢迎" />
            <ListBox x:Name="RecentAnimationsList" Classes="plain aside" ItemsSource="{Binding RecentAnimations}" ItemTemplate="{StaticResource AnimationActivityTemplate}" AutomationProperties.Name="最近播放" />
            <Panel IsVisible="{Binding #RecentAnimationsList.IsVisible}">
              <TextBlock Classes="hint" Text="暂无播放记录" Margin="16,8" IsVisible="{Binding !RecentAnimations.Count}" />
            </Panel>
            <ListBox x:Name="RecentQueriesAndAnnouncementsList" Classes="plain aside" ItemsSource="{Binding RecentQueriesAndAnnouncements}" ItemTemplate="{StaticResource FeatureActivityTemplate}" AutomationProperties.Name="最近回复和播报" />
          </Panel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
