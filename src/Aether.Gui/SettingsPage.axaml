<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Aether.Gui">
  <Style Selector=":is(local|SettingsPage)">
    <Setter Property="Template">
      <ControlTemplate TargetType="local:SettingsPage" x:DataType="local:MainWindowViewModel">
        <Grid RowDefinitions="60,Auto,*">
          <Border Classes="pageHeader">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="12">
              <TextBlock x:Name="PageTitle" Classes="h1" VerticalAlignment="Center" Text="{TemplateBinding Title}" />
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding HeaderTabs}" VerticalAlignment="Center" />
              <Panel Grid.Column="2" IsEnabled="{TemplateBinding FileError, Converter={x:Static ObjectConverters.IsNull}}">
                <ContentPresenter Content="{TemplateBinding HeaderContent}" />
              </Panel>
              <TextBlock Grid.Column="3" x:Name="TimingHint" Classes="caption muted singleLine" VerticalAlignment="Center" Text="{TemplateBinding TimingHint}" />
            </Grid>
          </Border>
          <StackPanel Grid.Row="1">
            <Border Classes="notice error" Margin="20,14,20,0" IsVisible="{Binding #FileMessage.IsVisible}">
              <Grid ColumnDefinitions="18,*" ColumnSpacing="10">
                <Viewbox Classes="icon"><Path Data="{StaticResource Icon.Notice}" Stroke="{DynamicResource Danger}" /></Viewbox>
                <TextBlock Grid.Column="1" x:Name="FileMessage" Classes="secondary" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                  Text="{Binding FileError.Message, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=''}"
                  IsVisible="{TemplateBinding FileError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </Grid>
            </Border>
            <Border x:Name="ReconnectNotice" Classes="notice warning" IsVisible="{TemplateBinding ShowReconnectNotice}" Margin="20,14,20,0">
              <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="10">
                <Viewbox Classes="icon"><Path Data="{StaticResource Icon.Notice}" Stroke="{DynamicResource Warning.Text}" /></Viewbox>
                <TextBlock Grid.Column="1" Classes="secondary singleLine" Text="已保存，重新连接后生效。" VerticalAlignment="Center" />
                <Button Grid.Column="2" x:Name="ReconnectButton" Content="重新连接" Command="{Binding ReconnectCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ContentPresenter Content="{TemplateBinding HeaderNote}" />
          </StackPanel>
          <Grid Grid.Row="2" x:Name="PART_PageLayout" ColumnDefinitions="*,Auto" RowDefinitions="*,0">
            <Grid RowDefinitions="*,Auto">
              <Grid x:Name="PART_BodyLayout" RowDefinitions="*,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="20,18">
                  <StackPanel>
                    <ContentPresenter Content="{TemplateBinding BodyContent}" />
                  </StackPanel>
                </ScrollViewer>
                <ContentPresenter Grid.Row="1" Content="{TemplateBinding BelowBodyContent}" />
              </Grid>
              <Border Grid.Row="1" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="20,12,20,18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Classes="caption muted" Text="没有未保存的修改" IsVisible="{Binding !#DirtyMessage.IsVisible}" />
                    <TextBlock x:Name="DirtyMessage" Classes="caption accent" Text="{TemplateBinding DirtyText}" IsVisible="{TemplateBinding IsDirty}" />
                    <TextBlock x:Name="Message" Classes="caption" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Text="{TemplateBinding Message}"
                      IsVisible="{Binding #Message.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="PART_SaveButton" Content="保存" Classes="accent" MinWidth="80" Height="34" IsEnabled="{TemplateBinding CanSave}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </Grid>
            <Border x:Name="PART_RecentActivity" Grid.Column="1" Width="300" Background="{DynamicResource Surface.Aside}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0"
              IsVisible="{TemplateBinding ActivityContent, Converter={x:Static ObjectConverters.IsNotNull}}">
              <ContentPresenter Content="{TemplateBinding ActivityContent}" />
            </Border>
          </Grid>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
    <Style Selector="ListBox.viewTabs">
      <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></Setter>
    </Style>
    <Style Selector="ListBox.viewTabs ListBoxItem">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>
    <Style Selector="ListBox.viewTabs ListBoxItem:selected /template/ ContentPresenter, ListBox.viewTabs ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BoxShadow" Value="0 1 2 0 #1F000000" />
    </Style>
</Styles>
