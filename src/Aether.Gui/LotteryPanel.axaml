<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Aether.Gui" x:Class="Aether.Gui.LotteryPanel" x:DataType="local:MainWindowViewModel">
  <UserControl.Styles>
    <!-- 本场 / 历史 as on canvases O1 and O4: a subtle strip, the picked view raised as a card. -->
    <Style Selector="ListBox#ViewTabs">
      <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></Setter>
    </Style>
    <Style Selector="ListBox#ViewTabs ListBoxItem">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>
    <Style Selector="ListBox#ViewTabs ListBoxItem:selected /template/ ContentPresenter, ListBox#ViewTabs ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BoxShadow" Value="0 1 2 0 #1F000000" />
    </Style>
    <!-- Phase chip, as on canvases V1 and O1: neutral while idle, accent while spinning or open, warning while drawing, success once ended. -->
    <Style Selector="Border#PhaseChip">
      <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>
    <Style Selector="Border#PhaseChip Ellipse">
      <Setter Property="Fill" Value="{DynamicResource Text.Disabled}" />
    </Style>
    <Style Selector="Border#PhaseChip.spinning">
      <Setter Property="Background" Value="{DynamicResource Accent.Tint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Tint}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent.Text}" />
    </Style>
    <Style Selector="Border#PhaseChip.spinning Ellipse">
      <Setter Property="Fill" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border#PhaseChip.drawing">
      <Setter Property="Background" Value="{DynamicResource Warning.Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Warning.Border}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Warning.Text}" />
    </Style>
    <Style Selector="Border#PhaseChip.drawing Ellipse">
      <Setter Property="Fill" Value="{DynamicResource Warning.Dot}" />
    </Style>
    <Style Selector="Border#PhaseChip.ended">
      <Setter Property="Background" Value="{DynamicResource Success.Tint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Success.Tint}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Success}" />
    </Style>
    <Style Selector="Border#PhaseChip.ended Ellipse">
      <Setter Property="Fill" Value="{DynamicResource Success}" />
    </Style>
    <Style Selector="Button#NewButton, Button#CancelButton">
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <!-- Locked while a draw runs: the canvas greys the boxes but keeps the text readable. -->
    <Style Selector="TextBox[IsReadOnly=True] /template/ Border#PART_BorderElement, TextBox[IsReadOnly=True]:pointerover /template/ Border#PART_BorderElement, TextBox[IsReadOnly=True]:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.poolDraw">
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.poolDraw.fresh">
      <Setter Property="Background" Value="{DynamicResource Accent.Flash}" />
    </Style>
    <Style Selector="StackPanel#StatusPanel TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
    </Style>
    <Style Selector="StackPanel#StatusPanel TextBlock.caption.error">
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="60,*">
    <Border Classes="pageHeader">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="12">
        <TextBlock Classes="h1" Text="抽奖" VerticalAlignment="Center" />
        <ListBox Grid.Column="1" x:Name="ViewTabs" SelectedIndex="0" VerticalAlignment="Center" AutomationProperties.Name="抽奖视图">
          <ListBoxItem Content="本场" />
          <ListBoxItem><TextBlock x:Name="HistoryTabText" Text="{Binding Lottery.LotteryHistoryTabText}" /></ListBoxItem>
        </ListBox>
        <Border Grid.Column="2" x:Name="ModeChip" Height="24" Padding="8,0" CornerRadius="6" Background="{DynamicResource Border.Subtle}" VerticalAlignment="Center">
          <TextBlock x:Name="ModeText" Classes="caption" Text="{Binding Lottery.LotteryModeText}" Foreground="{DynamicResource Text.Secondary}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Column="3" x:Name="PhaseChip" Height="24" Padding="10,0" CornerRadius="12" BorderThickness="1" VerticalAlignment="Center"
          Classes.spinning="{Binding Lottery.IsLotterySpinning}" Classes.drawing="{Binding Lottery.IsLotteryDrawing}" Classes.ended="{Binding Lottery.IsLotteryEnded}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="7" Height="7" VerticalAlignment="Center" />
            <TextBlock x:Name="PhaseText" Classes="caption" Text="{Binding Lottery.LotteryPanelPhaseText}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </Border>
        <TextBlock Grid.Column="4" x:Name="NewHint" Classes="caption muted singleLine" Text="{Binding Lottery.NewLotteryHint}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Button Grid.Column="5" x:Name="NewButton" IsEnabled="{Binding Lottery.CanNew}" Height="32" Padding="10,0,12,0" FontWeight="SemiBold" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Viewbox Classes="icon" Width="16" Height="16"><Path Data="{StaticResource Icon.Add}" StrokeThickness="2" /></Viewbox>
            <TextBlock Text="新开一场" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <local:LotteryHistoryPanel Grid.Row="1" x:Name="HistoryContent" IsVisible="False" />
    <local:EntryLotteryPanel Grid.Row="1" x:Name="EntryContent" IsVisible="False" />
    <Grid Grid.Row="1" x:Name="PoolContent" ColumnDefinitions="*,Auto">
      <Grid RowDefinitions="*,Auto">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="20,18">
          <StackPanel Spacing="22">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Classes="section" Text="奖品" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="hint singleLine" Text="按占比随机抽一件，不会抽完；档次决定开奖特效" VerticalAlignment="Center" ToolTip.Tip="按占比随机抽一件，不会抽完；档次决定开奖特效" />
                <local:LotteryPrizeSetPicker Grid.Column="2" x:Name="PoolPrizeSets" />
              </Grid>
              <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8">
                <ItemsControl x:Name="PrizeRows" Classes="editableRows dividedRows" ItemsSource="{Binding Lottery.Prizes}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:PoolPrizeRow">
                      <local:EditableRowFrame BorderBrush="{DynamicResource Border.Subtle}" Padding="12,8,6,8" MinHeight="48">
                        <StackPanel Spacing="4">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto,30" ColumnSpacing="8">
                            <TextBox x:Name="NameInput" Classes="rowFocus" Height="32" MinHeight="32" FontSize="13" PlaceholderText="奖品名称"
                              Text="{Binding Name, Mode=TwoWay}" IsReadOnly="{Binding !CanEdit}" Classes.invalid="{Binding NameInvalid}"
                              AutomationProperties.Name="{Binding Number, StringFormat='第 {0} 件奖品名称'}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                              <TextBlock Classes="caption" Text="占比" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                              <TextBox x:Name="WeightInput" Classes="numeric" Width="52" Height="32" MinHeight="32" FontSize="13" Padding="8,0" TextAlignment="Right"
                                Text="{Binding Weight, Mode=TwoWay}" IsReadOnly="{Binding !CanEdit}" Classes.invalid="{Binding WeightInvalid}"
                                AutomationProperties.Name="{Binding Number, StringFormat='第 {0} 件奖品占比'}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Classes="caption numeric muted" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding Percentage}" />
                            <local:GradePicker Grid.Column="3" x:Name="GradeInput" VerticalAlignment="Center" SelectedItem="{Binding Grade, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                              AutomationProperties.Name="{Binding Number, StringFormat='第 {0} 件奖品档次'}" />
                            <Button Grid.Column="4" x:Name="RemoveButton" Classes="ghost danger" Width="30" Height="30" Command="{Binding Remove}"
                              IsVisible="{Binding CanEdit}" IsEnabled="{Binding CanRemove}" AutomationProperties.Name="{Binding Number, StringFormat='删除第 {0} 件奖品'}">
                              <Viewbox Classes="icon" Width="16" Height="16"><Path Data="{StaticResource Icon.Remove}" /></Viewbox>
                            </Button>
                          </Grid>
                          <TextBlock x:Name="ErrorMessage" Classes="error" Text="{Binding VisibleError}" IsVisible="{Binding VisibleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                      </local:EditableRowFrame>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <!-- Click on press, as 添加欢迎语 does: leaving a new row above reveals its error before the release. -->
              <Grid x:Name="AddPrizeBar" IsVisible="{Binding Lottery.PoolIdle}" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Button x:Name="AddButton" IsEnabled="{Binding Lottery.CanAddPrize}" HorizontalAlignment="Left" Padding="10,0,12,0" ClickMode="Press">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Viewbox Classes="icon" Width="16" Height="16"><Path Data="{StaticResource Icon.Add}" /></Viewbox>
                    <TextBlock Text="添加奖品" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Classes="caption muted singleLine" Text="最多 10 件；新开一场会带出上一场的奖品、口令和 UID" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Classes="section" Text="谁来喊停" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Classes="hint" Text="每次只认一位观众，别人发了不算；不填就只能主播点“停”" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <TextBlock Classes="label" Text="这次谁来喊" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <TextBox x:Name="UidInput" Text="{Binding Lottery.Uid, Mode=TwoWay}" IsReadOnly="{Binding !Lottery.CanEditPool}" Classes="numeric" Width="150" Height="32" MinHeight="32" FontSize="13" PlaceholderText="观众 UID" AutomationProperties.Name="喊停观众 UID" Classes.invalid="{Binding #UidError.IsVisible}" />
                  <TextBlock x:Name="ViewerHint" Classes="caption singleLine" Text="{Binding Lottery.PoolViewerHint}" Classes.success="{Binding Lottery.PoolViewerKnown}" Classes.muted="{Binding !Lottery.PoolViewerKnown}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UidError" Classes="error" Text="{Binding Lottery.UidError}" IsVisible="{Binding Lottery.UidError, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Grid.Row="2" Classes="label" Text="口令" VerticalAlignment="Center" Margin="0,10,0,0" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                  <TextBox x:Name="StopWordInput" Text="{Binding Lottery.StopWord, Mode=TwoWay}" IsReadOnly="{Binding !Lottery.CanEditPool}" Width="150" Height="32" MinHeight="32" FontSize="13" AutomationProperties.Name="口令" Classes.invalid="{Binding #StopWordError.IsVisible}" />
                  <TextBlock Classes="caption muted singleLine" Text="弹幕内容和口令完全一样才算" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="StopWordError" Classes="error" Text="{Binding Lottery.StopWordError}" IsVisible="{Binding Lottery.StopWordError, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
              </Grid>
            </StackPanel>
            <local:LotteryThemePicker x:Name="PoolTheme" />
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="20,12,20,18">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel x:Name="StatusPanel" VerticalAlignment="Center" Spacing="4">
              <TextBlock x:Name="StatusText" Text="{Binding Lottery.PoolStatusText}" Classes="caption singleLine" AutomationProperties.LiveSetting="Polite" />
              <TextBlock x:Name="ErrorMessage" Classes="caption error" Text="{Binding Lottery.PoolLotteryError}" IsVisible="{Binding Lottery.PoolLotteryError, Converter={x:Static ObjectConverters.IsNotNull}}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Button x:Name="CancelButton" IsVisible="{Binding Lottery.PoolSpinning}" IsEnabled="{Binding Lottery.CanCancel}" Content="取消" Height="34" Padding="14,0" />
              <Button x:Name="StopButton" IsVisible="{Binding Lottery.PoolSpinning}" IsEnabled="{Binding Lottery.CanStop}" Classes="accent" Height="34" MinWidth="120" Padding="18,0" FontWeight="Bold">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="8" Height="8" CornerRadius="1" Background="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
                  <TextBlock Text="停" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="StartButton" IsVisible="{Binding Lottery.PoolIdle}" IsEnabled="{Binding Lottery.CanStart}" Classes="accent" Content="开始" Height="34" MinWidth="96" Padding="16,0" FontWeight="SemiBold" />
              <Button x:Name="DrawingButton" IsVisible="{Binding Lottery.PoolDrawing}" Classes="accent" Content="开奖中…" Height="34" MinWidth="96" Padding="16,0" FontWeight="SemiBold" IsEnabled="False" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Column="1" Width="280" Background="{DynamicResource Surface.Aside}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,Auto,*">
          <Border x:Name="LatestCard" IsVisible="{Binding Lottery.ShowLatestPoolDraw}" Margin="16,16,16,4" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Accent}" Background="{DynamicResource Accent.Flash}">
            <StackPanel Spacing="4">
              <TextBlock x:Name="LatestHead" Classes="caption muted singleLine" Text="{Binding Lottery.LatestPoolDrawHead}" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <local:GradeBadge x:Name="LatestGrade" Grade="{Binding Lottery.LatestPoolDrawGrade}" Height="20" Padding="6,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="LatestPrize" Classes="singleLine" Text="{Binding Lottery.LatestPoolDrawPrize}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </Border>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="16,14,16,8">
            <TextBlock Classes="section" Text="开奖记录" />
            <TextBlock Grid.Column="1" x:Name="DrawCount" Classes="caption muted numeric" Text="{Binding Lottery.PoolDrawCountText}" VerticalAlignment="Center" />
          </Grid>
          <Panel Grid.Row="2">
            <TextBlock x:Name="EmptyHistory" Classes="hint" Text="暂无开奖记录" IsVisible="{Binding Lottery.IsPoolDrawsEmpty}" Margin="16,0" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="HistoryRows" ItemsSource="{Binding Lottery.PoolDraws}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:PoolDrawRow">
                    <Border Classes="poolDraw" Classes.fresh="{Binding Fresh}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Classes="singleLine" Text="{Binding Viewer}" FontSize="13" FontWeight="SemiBold" MaxWidth="84" VerticalAlignment="Center" />
                          <Border Classes="badge neutralBadge" IsVisible="{Binding StoppedByHost}" Height="18" VerticalAlignment="Center" ToolTip.Tip="主播点停">
                            <TextBlock Text="点停" />
                          </Border>
                          <local:GradeBadge Grade="{Binding Grade}" Height="18" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Classes="singleLine" Text="{Binding Prize}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="caption muted numeric" Text="{Binding Time}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
