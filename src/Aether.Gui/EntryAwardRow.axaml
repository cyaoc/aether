<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Aether.Gui.EntryAwardRow">
  <Border x:Name="RowBorder" BorderBrush="{DynamicResource Border.Subtle}" Padding="12,8,6,8" MinHeight="48">
    <StackPanel Spacing="4">
      <Grid ColumnDefinitions="82,*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBox x:Name="NameInput" Height="32" MinHeight="32" FontSize="13" PlaceholderText="奖项名称" />
        <TextBox Grid.Column="1" x:Name="PrizeInput" Height="32" MinHeight="32" FontSize="13" PlaceholderText="奖品" />
        <StackPanel Grid.Column="2" x:Name="CapacityPanel" Orientation="Horizontal" Spacing="6">
          <TextBox x:Name="CapacityInput" Classes="numeric" Width="44" Height="32" MinHeight="32" FontSize="13" Padding="6,0" TextAlignment="Right" />
          <TextBlock Classes="caption muted" Text="名" VerticalAlignment="Center" />
        </StackPanel>
        <ListBox Grid.Column="3" x:Name="GradeInput" Classes="prizeGrade" SelectionMode="AlwaysSelected" VerticalAlignment="Center" />
        <Button Grid.Column="4" x:Name="RemoveButton" Classes="ghost danger" Width="30" Height="30">
          <Viewbox Classes="icon" Width="16" Height="16"><Path Data="{StaticResource Icon.Remove}" /></Viewbox>
        </Button>
        <Border Grid.Column="2" x:Name="GradeBadge" Classes="badge" Height="20" Padding="6,0" VerticalAlignment="Center" IsVisible="False">
          <TextBlock x:Name="GradeText" VerticalAlignment="Center" />
        </Border>
        <TextBlock Grid.Column="3" x:Name="DrawCount" Classes="caption muted numeric" VerticalAlignment="Center" IsVisible="False" />
        <Button Grid.Column="4" x:Name="DrawButton" Classes="accent" Content="抽一个" Height="32" Padding="10,0" IsVisible="False" />
      </Grid>
      <TextBlock x:Name="ErrorMessage" Classes="error" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </Border>
</UserControl>
