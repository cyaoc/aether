<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:gui="using:Aether.Gui" x:Class="Aether.Gui.PoolPrizeRow">
  <Border x:Name="RowBorder" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="12,8,6,8" MinHeight="48">
    <StackPanel Spacing="4">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,30" ColumnSpacing="8">
        <TextBox x:Name="NameInput" Height="32" MinHeight="32" FontSize="13" PlaceholderText="奖品名称" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="caption" Text="占比" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
          <TextBox x:Name="WeightInput" Classes="numeric" Width="52" Height="32" MinHeight="32" FontSize="13" Padding="8,0" TextAlignment="Right" />
        </StackPanel>
        <TextBlock Grid.Column="2" x:Name="Percentage" Classes="caption numeric muted" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" />
        <gui:GradePicker Grid.Column="3" x:Name="GradeInput" VerticalAlignment="Center" />
        <Button Grid.Column="4" x:Name="RemoveButton" Classes="ghost danger" Width="30" Height="30">
          <Viewbox Classes="icon" Width="16" Height="16"><Path Data="{StaticResource Icon.Remove}" /></Viewbox>
        </Button>
      </Grid>
      <TextBlock x:Name="ErrorMessage" Classes="error" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </Border>
</UserControl>
