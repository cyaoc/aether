<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Aether.Gui" x:Class="Aether.Gui.OnlineRankPicker" x:Name="Root" Width="{Binding Height, RelativeSource={RelativeSource Self}}" Height="32">
  <UserControl.Styles>
    <Style Selector="Viewbox.onlineRankSpinner">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <Button x:Name="PickerButton" Width="{Binding #Root.Width}" Height="{Binding #Root.Height}" MinHeight="0" Padding="0" VerticalAlignment="Center"
    ToolTip.ShowOnDisabled="True" Background="{DynamicResource Surface.Card}" AutomationProperties.Name="{Binding #Root.AccessibleName}">
    <Viewbox Classes="icon" Width="16" Height="16"><Path Data="{StaticResource Icon.Users}" /></Viewbox>
    <Button.Flyout>
      <Flyout Placement="BottomEdgeAlignedLeft" VerticalOffset="6" FlyoutPresenterClasses="onlineRank">
        <StackPanel x:Name="FlyoutContent" Focusable="True">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,8,10,6">
            <TextBlock Text="在线榜" FontSize="13" FontWeight="SemiBold" />
            <TextBlock x:Name="RankSummary" Classes="caption muted numeric" VerticalAlignment="Center" />
          </StackPanel>
          <Grid x:Name="Loading" Height="112">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Viewbox Classes="icon onlineRankSpinner" Width="16" Height="16" TextElement.Foreground="{DynamicResource Text.Muted}"><Path Data="{StaticResource Icon.Spinner}" /></Viewbox>
              <TextBlock Classes="caption muted" Text="正在读取在线榜…" />
            </StackPanel>
          </Grid>
          <StackPanel x:Name="MessagePanel" Margin="10,14,10,16" Spacing="4" IsVisible="False">
            <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="MessageHint" Classes="caption muted singleLine" />
          </StackPanel>
          <ListBox x:Name="RankList" Classes="onlineRank" Focusable="True" MaxHeight="256" Padding="0" Background="Transparent" BorderThickness="0" IsVisible="False">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:OnlineRankRow">
                <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Rank}" Classes="caption muted numeric" FontWeight="Normal" TextAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Viewer.Nickname}" Classes="singleLine" FontSize="13" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Viewer.Uid}" Classes="caption muted numeric" FontWeight="Normal" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Subtle}" Padding="10,8,10,6" Margin="0,2,0,0">
            <TextBlock x:Name="Footer" Classes="caption muted singleLine" />
          </Border>
        </StackPanel>
      </Flyout>
    </Button.Flyout>
  </Button>
</UserControl>
