<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Aether.Gui" x:Class="Aether.Gui.OnlineRankPicker" x:Name="Root" Width="{Binding Height, RelativeSource={RelativeSource Self}}" Height="32">
  <UserControl.Styles>
    <Style Selector="Button.open">
      <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
    </Style>
    <Style Selector="Viewbox.onlineRankSpinner">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="FlyoutPresenter.onlineRank">
      <Setter Property="Width" Value="340" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBox.onlineRank ListBoxItem">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.onlineRank ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
    </Style>
    <Style Selector="ListBox.onlineRank ListBoxItem:selected /template/ ContentPresenter, ListBox.onlineRank ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent.Tint}" />
    </Style>
    <Style Selector="ListBox.onlineRank ListBoxItem:selected TextBlock.nickname">
      <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>
  <Button x:Name="PickerButton" Width="{Binding #Root.Width}" Height="{Binding #Root.Height}" MinHeight="0" Padding="0" VerticalAlignment="Center"
    ToolTip.ShowOnDisabled="True" Background="{DynamicResource Surface.Card}" CornerRadius="6" AutomationProperties.Name="{Binding #Root.AccessibleName}">
    <Viewbox Classes="icon" Width="16" Height="16"><Path Data="{StaticResource Icon.Users}" /></Viewbox>
    <Button.Flyout>
      <Flyout Placement="BottomEdgeAlignedLeft" VerticalOffset="6" FlyoutPresenterClasses="onlineRank">
        <StackPanel x:Name="FlyoutContent" Focusable="True">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,6,10,8">
            <TextBlock Text="在线榜" FontSize="13" FontWeight="SemiBold" />
            <TextBlock x:Name="RankSummary" Classes="caption muted" VerticalAlignment="Center" />
          </StackPanel>
          <Grid x:Name="Loading" Height="112">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Viewbox Classes="icon onlineRankSpinner" Width="16" Height="16" TextElement.Foreground="{DynamicResource Text.Muted}"><Path Data="M21 12a9 9 0 1 1-6.22-8.56" /></Viewbox>
              <TextBlock Classes="caption muted" Text="正在读取在线榜…" />
            </StackPanel>
          </Grid>
          <StackPanel x:Name="MessagePanel" Margin="10,16,10,20" Spacing="8" IsVisible="False">
            <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="MessageHint" Classes="caption muted" TextWrapping="Wrap" />
          </StackPanel>
          <ListBox x:Name="RankList" Classes="onlineRank" Focusable="True" MaxHeight="256" Padding="0" Background="Transparent" BorderThickness="0" IsVisible="False">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:OnlineRankRow">
                <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Rank}" Classes="caption muted numeric" TextAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Viewer.Nickname}" Classes="nickname singleLine" FontSize="13" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Viewer.Uid}" Classes="caption muted numeric" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Subtle}" Padding="10,8,10,6" Margin="0,2,0,0">
            <TextBlock x:Name="Footer" Classes="caption muted" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Flyout>
    </Button.Flyout>
  </Button>
</UserControl>
