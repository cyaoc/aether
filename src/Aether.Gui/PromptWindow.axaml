<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aether.Gui.PromptWindow"
        Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="24">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" IsCancel="True" IsDefault="True" Click="Cancel" />
      <Button x:Name="ConfirmButton" Classes="danger" Click="Confirm" />
    </StackPanel>
  </StackPanel>
</Window>
