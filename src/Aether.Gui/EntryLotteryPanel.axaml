<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Aether.Gui" x:Class="Aether.Gui.EntryLotteryPanel" x:DataType="local:MainWindowViewModel">
  <UserControl.Styles>
    <!-- Winner chips and entry rows as on canvas O1; the draw on air stays highlighted until the 抽奖页 finishes it. -->
    <Style Selector="Border.winner.fresh">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Background" Value="{DynamicResource Accent.Flash}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent.Text}" />
    </Style>
    <Style Selector="Border.entryRow">
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.entryRow.fresh">
      <Setter Property="Background" Value="{DynamicResource Accent.Flash}" />
    </Style>
    <Style Selector="Border.badge.won">
      <Setter Property="Background" Value="{DynamicResource Accent.Tint}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent.Text}" />
      <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    </Style>
    <!-- The confirming 结束 is the canvas's solid danger button. -->
    <Style Selector="Button#ConfirmEndButton">
      <Setter Property="Background" Value="{DynamicResource Danger}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent.OnSolid}" />
    </Style>
    <Style Selector="Button#ConfirmEndButton:pointerover /template/ ContentPresenter, Button#ConfirmEndButton:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Danger}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent.OnSolid}" />
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="*,300">
    <Grid RowDefinitions="*,Auto">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="20,18">
        <StackPanel Spacing="22">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <TextBlock Classes="section" Text="报名条件" />
              <TextBlock Grid.Column="1" Classes="hint" Text="观众发的弹幕和关键字完全一样就算报名，每人只算一次" />
            </Grid>
            <Grid ColumnDefinitions="Auto,160,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
              <TextBlock Classes="label" Text="报名关键字" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" x:Name="KeywordInput" Height="32" MinHeight="32" FontSize="13" AutomationProperties.Name="报名关键字" Classes.invalid="{Binding #KeywordError.IsVisible}" />
              <TextBlock Grid.Column="2" x:Name="KeywordHint" Classes="caption muted singleLine" Text="不能靠送礼物报名" VerticalAlignment="Center" />
              <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="KeywordError" Classes="error" IsVisible="False" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
            </Grid>
          </StackPanel>
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <TextBlock Classes="section" Text="奖项" />
              <TextBlock Grid.Column="1" Classes="hint" Text="中过奖的人不再参加这一场后面的奖项" />
            </Grid>
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8"><StackPanel x:Name="AwardRows" /></Border>
            <!-- Click on press, as 添加奖品 does: leaving a new row above reveals its error before the release. -->
            <Grid x:Name="AddAwardBar" ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <Button x:Name="AddAwardButton" ClickMode="Press" Padding="10,0,12,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Viewbox Classes="icon" Width="16" Height="16"><Path Data="{StaticResource Icon.Add}" /></Viewbox>
                  <TextBlock Text="添加奖项" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBlock Grid.Column="1" Classes="caption muted singleLine" Text="最多 5 个奖项；档次决定开奖特效" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
          <local:LotteryThemePicker x:Name="EntryTheme" />
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="1" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="20,12,20,18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <StackPanel VerticalAlignment="Center" Spacing="4">
            <TextBlock x:Name="StatusText" Classes="caption muted singleLine" Text="{Binding Lottery.EntryStatusText}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="ErrorMessage" Classes="caption error" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
            <TextBlock x:Name="ConfirmEndText" Classes="singleLine" FontSize="13" Foreground="{DynamicResource Text.Secondary}" Text="结束后不能再抽，确定吗？" VerticalAlignment="Center" IsVisible="False" />
            <Button x:Name="CancelEndButton" Content="取消" Height="34" Padding="14,0" IsVisible="False" />
            <Button x:Name="StartEntryButton" Classes="accent" Content="开始报名" Height="34" MinWidth="96" Padding="16,0" FontWeight="SemiBold" />
            <Button x:Name="CloseEntriesButton" Classes="accent" Content="截止报名" Height="34" MinWidth="96" Padding="16,0" FontWeight="SemiBold" />
            <Button x:Name="EndEntryButton" Content="结束这场抽奖" Height="34" MinWidth="96" Padding="16,0" FontWeight="SemiBold" />
            <Button x:Name="ConfirmEndButton" Content="结束" Height="34" MinWidth="96" Padding="16,0" FontWeight="SemiBold" IsVisible="False" />
            <Button x:Name="VisibilityButton" Content="{Binding Lottery.EntryVisibilityText}" Height="34" MinWidth="96" Padding="16,0" FontWeight="SemiBold" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Column="1" Background="{DynamicResource Surface.Aside}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="16,18,16,8">
          <TextBlock Classes="section" Text="中奖名单" />
          <TextBlock Grid.Column="1" x:Name="WinnerCount" Classes="caption muted numeric" Text="{Binding Lottery.EntryWinnerCountText}" VerticalAlignment="Center" />
        </Grid>
        <ScrollViewer Grid.Row="1" MaxHeight="210" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,0,16,12">
            <TextBlock x:Name="EmptyWinners" Classes="hint" Text="截止报名后开奖，中奖的人会列在这里" IsVisible="{Binding Lottery.IsEntryWinnersEmpty}" />
            <ItemsControl x:Name="WinnerGroups" ItemsSource="{Binding Lottery.EntryWinnerGroups}" ItemTemplate="{StaticResource WinnerGroupTemplate}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,12,16,8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="section" Text="报名" />
            <TextBlock Grid.Column="1" x:Name="EntryCount" Classes="caption muted numeric" Text="{Binding Lottery.LotteryEntryCountText}" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <TextBlock Grid.Row="3" x:Name="EmptyEntries" Classes="hint" Text="开始报名后，满足条件的观众会出现在这里" IsVisible="{Binding Lottery.IsLotteryEntriesEmpty}" Margin="16,4" />
        <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="EntryRows" ItemsSource="{Binding Lottery.LotteryEntries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:LotteryEntryRow">
                <Border Classes="entryRow" Classes.fresh="{Binding Fresh}">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBlock Classes="singleLine" Text="{Binding Nickname}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="caption muted numeric" Text="{Binding Time}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="badge won" Height="20" Padding="6,0" VerticalAlignment="Center"
                      IsVisible="{Binding Award, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Classes="singleLine" Text="{Binding Award}" MaxWidth="90" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
