<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aether.Gui.SettingsWindow"
        Title="设置 · Aether" Width="480" Height="480" MinWidth="400" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="24">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,20,0,0">
      <Button Content="打开设置文件" Click="OpenFile" />
      <Button Grid.Column="1" x:Name="SaveButton" Content="保存" Classes="accent" MinWidth="80"
              HorizontalContentAlignment="Center" Click="Save" />
    </Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10">
        <TextBlock Text="日志" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="保留天数（重启后生效）" />
        <NumericUpDown x:Name="RetentionInput" FormatString="0.############################"
                       HorizontalAlignment="Stretch" AutomationProperties.Name="日志保留天数" />
        <TextBlock x:Name="RetentionReadOnly" Classes="hint" Text="此项不能逐行编辑，请在设置文件里修改。" />
        <TextBlock Text="级别（重启后生效）" Margin="0,8,0,0" />
        <ComboBox x:Name="LevelInput" HorizontalAlignment="Stretch" AutomationProperties.Name="日志级别" />
        <TextBlock x:Name="LevelReadOnly" Classes="hint" Text="此项不能逐行编辑，请在设置文件里修改。" />
        <TextBlock Text="盲盒统计" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,0" />
        <CheckBox x:Name="BlindBoxInput" Content="记录盲盒（下次观看直播间时生效）" />
        <TextBlock x:Name="BlindBoxReadOnly" Classes="hint" Text="此项不能逐行编辑，请在设置文件里修改。" />
        <TextBlock Text="查询关键字（下次观看直播间时生效）" />
        <TextBox x:Name="KeywordInput" AutomationProperties.Name="盲盒查询关键字" />
        <TextBlock x:Name="KeywordReadOnly" Classes="hint" Text="此项不能逐行编辑，请在设置文件里修改。" />
        <CheckBox x:Name="AnnounceInput" Content="盲盒播报（下次观看直播间时生效）" />
        <TextBlock x:Name="AnnounceReadOnly" Classes="hint" Text="此项不能逐行编辑，请在设置文件里修改。" />
        <TextBlock Text="发送队列" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,0" />
        <TextBlock Text="发送间隔秒数（下次观看直播间时生效）" />
        <NumericUpDown x:Name="SendIntervalInput" FormatString="0.############################"
                       HorizontalAlignment="Stretch" AutomationProperties.Name="发送间隔秒数" />
        <TextBlock x:Name="SendIntervalReadOnly" Classes="hint" Text="此项不能逐行编辑，请在设置文件里修改。" />
        <TextBlock Text="进场欢迎" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,0" />
        <CheckBox x:Name="WelcomeInput" Content="进场欢迎（下次观看直播间时生效）" />
        <TextBlock x:Name="WelcomeReadOnly" Classes="hint" Text="此项不能逐行编辑，请在设置文件里修改。" />
        <TextBlock Text="欢迎语（下次观看直播间时生效）" />
        <TextBox x:Name="WelcomeTextInput" AutomationProperties.Name="欢迎语" />
        <TextBlock x:Name="WelcomeTextReadOnly" Classes="hint" Text="此项不能逐行编辑，请在设置文件里修改。" />
        <TextBlock x:Name="WelcomeTextHint" Classes="hint"
                   Text="英文、数字、半角符号算 1，其他字符算 2。上限自动读取账号的。可用 {@}（只能放开头）、{昵称}、{大航海}；用 {{ 和 }} 转义花括号。" />
        <TextBlock Classes="hint" Text="满足下面任意一个欢迎条件就欢迎。" />
        <TextBlock Text="指定观众的 UID（下次观看直播间时生效）" />
        <TextBox x:Name="WelcomeUidsInput" AutomationProperties.Name="欢迎指定观众的 UID" />
        <TextBlock x:Name="WelcomeUidsReadOnly" Classes="hint" Text="此项不能逐行编辑，请在设置文件里修改。" />
        <TextBlock Classes="hint" Text="例如 [12345, 67890]，[] 表示关闭。" />
        <TextBlock Text="本直播间粉丝团等级门槛（下次观看直播间时生效）" />
        <NumericUpDown x:Name="WelcomeFanClubInput" FormatString="0.############################"
                       HorizontalAlignment="Stretch" AutomationProperties.Name="欢迎粉丝团等级门槛" />
        <TextBlock x:Name="WelcomeFanClubReadOnly" Classes="hint" Text="此项不能逐行编辑，请在设置文件里修改。" />
        <TextBlock Classes="hint" Text="0 表示关闭。" />
        <TextBlock Text="大航海身份门槛（下次观看直播间时生效）" />
        <ComboBox x:Name="WelcomeGuardInput" HorizontalAlignment="Stretch" AutomationProperties.Name="欢迎大航海身份门槛" />
        <TextBlock x:Name="WelcomeGuardReadOnly" Classes="hint" Text="此项不能逐行编辑，请在设置文件里修改。" />
        <TextBlock Classes="hint" Text="例如提督表示提督和总督。" />
        <TextBlock Text="荣耀等级门槛（下次观看直播间时生效）" />
        <NumericUpDown x:Name="WelcomeWealthInput" FormatString="0.############################"
                       HorizontalAlignment="Stretch" AutomationProperties.Name="欢迎荣耀等级门槛" />
        <TextBlock x:Name="WelcomeWealthReadOnly" Classes="hint" Text="此项不能逐行编辑，请在设置文件里修改。" />
        <TextBlock Classes="hint" Text="0 表示关闭。" />
        <TextBlock x:Name="UnknownKeysMessage" Classes="hint" Margin="0,8,0,0" />
        <TextBlock x:Name="Message" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
