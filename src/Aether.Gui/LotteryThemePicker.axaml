<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Aether.Gui.LotteryThemePicker">
  <UserControl.Styles>
    <!-- Theme cards as on canvas O1/V1: a 16:9 preview, name and style, and a check on the selected card. -->
    <Style Selector="RadioButton.themeCard">
      <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.themeCard:checked">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="RadioButton.themeCard:focus-visible">
      <Setter Property="Background" Value="{DynamicResource Accent.Tint}" />
    </Style>
    <Style Selector="RadioButton.themeCard Viewbox.check">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="RadioButton.themeCard:checked Viewbox.check">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="10">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
      <TextBlock Classes="section" Text="直播画面主题" />
      <TextBlock Grid.Column="1" Classes="hint" Text="两种抽奖共用 · 素材 1920×1080 是横屏，1080×1920 是竖屏" />
    </Grid>
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
      <RadioButton x:Name="StarSummonCard" Classes="themeCard" IsChecked="True" AutomationProperties.Name="星辰召唤">
        <StackPanel Spacing="8">
          <!-- Scales a 160 × 90 preview to the card width, keeping 16:9. -->
          <Viewbox Stretch="Uniform">
            <Border Width="160" Height="90" CornerRadius="4" Background="#120E3A" ClipToBounds="True">
              <Border Margin="32,27" CornerRadius="4" BorderBrush="#FFD36B" BorderThickness="1" BoxShadow="0 0 10 0 #FFD36B" />
            </Border>
          </Viewbox>
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
            <TextBlock Text="星辰召唤" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="抽卡风" Classes="caption muted" VerticalAlignment="Center" />
            <Viewbox Grid.Column="3" Classes="icon check" Width="16" Height="16">
              <Path Data="{StaticResource Icon.Check}" StrokeThickness="2.2" Stroke="{DynamicResource Accent.Text}" />
            </Viewbox>
          </Grid>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="MechaLockCard" Grid.Column="1" Classes="themeCard" AutomationProperties.Name="机甲锁定">
        <StackPanel Spacing="8">
          <Viewbox Stretch="Uniform">
            <Border Width="160" Height="90" CornerRadius="4" Background="#0A0C10" ClipToBounds="True">
              <Grid RowDefinitions="6,*,6" Margin="8,12">
                <Border Background="#FF7A1A" />
                <Border Grid.Row="1" Margin="25,10" BorderBrush="#FF3D3D" BorderThickness="2">
                  <TextBlock Text="LOCK ON" FontSize="10" FontWeight="Bold" Foreground="#FFB067" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Row="2" Background="#FF7A1A" />
              </Grid>
            </Border>
          </Viewbox>
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
            <TextBlock Text="机甲锁定" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="警报风" Classes="caption muted" VerticalAlignment="Center" />
            <Viewbox Grid.Column="3" Classes="icon check" Width="16" Height="16">
              <Path Data="{StaticResource Icon.Check}" StrokeThickness="2.2" Stroke="{DynamicResource Accent.Text}" />
            </Viewbox>
          </Grid>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="CapsuleGachaCard" Grid.Column="2" Classes="themeCard" AutomationProperties.Name="萌系扭蛋">
        <StackPanel Spacing="8">
          <Viewbox Stretch="Uniform">
            <Border Width="160" Height="90" CornerRadius="4" Background="#FFF8EE" ClipToBounds="True">
              <Canvas>
                <Ellipse Canvas.Left="60" Canvas.Top="8" Width="40" Height="40" Fill="#DDF7EE" Stroke="#4B2A4F" StrokeThickness="2" />
                <Ellipse Canvas.Left="67" Canvas.Top="28" Width="14" Height="14" Fill="#FFD45E" Stroke="#4B2A4F" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="82" Canvas.Top="24" Width="14" Height="14" Fill="#FF7AAE" Stroke="#4B2A4F" StrokeThickness="1.5" />
                <Border Canvas.Left="60" Canvas.Top="48" Width="40" Height="32" CornerRadius="6" Background="#FF8DB8" BorderBrush="#4B2A4F" BorderThickness="2" BoxShadow="3 3 0 0 #4B2A4F">
                  <Ellipse Width="14" Height="14" Fill="#FFD45E" Stroke="#4B2A4F" StrokeThickness="2" />
                </Border>
              </Canvas>
            </Border>
          </Viewbox>
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
            <TextBlock Text="萌系扭蛋" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="粉彩" Classes="caption muted" VerticalAlignment="Center" />
            <Viewbox Grid.Column="3" Classes="icon check" Width="16" Height="16">
              <Path Data="{StaticResource Icon.Check}" StrokeThickness="2.2" Stroke="{DynamicResource Accent.Text}" />
            </Viewbox>
          </Grid>
        </StackPanel>
      </RadioButton>
    </Grid>
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
      <Button x:Name="ExampleButton" Height="30" Padding="10,0,12,0">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Viewbox Classes="icon" Width="14" Height="14"><Path Data="{StaticResource Icon.Play}" StrokeThickness="2" /></Viewbox>
          <TextBlock x:Name="ExampleText" Text="试一下" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <TextBlock Grid.Column="1" x:Name="ExampleHint" Classes="caption muted singleLine" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
    </Grid>
    <TextBlock x:Name="ErrorText" Classes="error" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
</UserControl>
