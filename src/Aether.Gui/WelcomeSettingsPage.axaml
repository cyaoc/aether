<local:SettingsPage xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Aether.Gui" xmlns:core="clr-namespace:Aether.Core;assembly=Aether.Core" x:DataType="local:MainWindowViewModel" x:Class="Aether.Gui.WelcomeSettingsPage">
  <local:SettingsPage.Resources>
    <DataTemplate x:Key="ConditionRowTemplate" x:DataType="local:WelcomeConditionRow">
      <local:EditableRowFrame>
        <StackPanel>
          <Grid x:Name="OrSeparator" IsVisible="{Binding HasSeparator}" ColumnDefinitions="*,Auto,*" ColumnSpacing="8" Margin="0,2">
            <Border Height="1" Background="{DynamicResource Border.Subtle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="caption muted" Text="或" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Border.Subtle}" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="18,90,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" Margin="0,8">
            <Viewbox x:Name="TypeIconBox" IsVisible="{Binding HasHeading}" Classes="icon"><Path x:Name="TypeIcon" Data="{Binding Icon}" Stroke="{DynamicResource Text.Muted}" /></Viewbox>
            <TextBlock Grid.Column="1" x:Name="TypeName" Text="{Binding Name}" IsVisible="{Binding HasHeading}" Classes="label" VerticalAlignment="Center" />
            <Grid Grid.Column="2">
              <TextBox x:Name="UidInput" Classes="numeric rowFocus" Text="{Binding Uid, Mode=TwoWay}" IsVisible="{Binding IsUid}" IsReadOnly="{Binding !CanEdit}" Classes.invalid="{Binding #ErrorMessage.IsVisible}" MaxWidth="200" HorizontalAlignment="Stretch" PlaceholderText="输入 UID" AutomationProperties.Name="指定观众 UID" />
              <Grid x:Name="ThresholdInput" IsVisible="{Binding !IsUid}" ColumnDefinitions="Auto,Auto,Auto" HorizontalAlignment="Left">
                <TextBlock Classes="label" Text="达到" VerticalAlignment="Center" Margin="0,0,12,0" />
                <!-- NumericUpDown initializes its text from Value when its template attaches. -->
                <NumericUpDown Grid.Column="1" x:Name="LevelInput" Classes="rowFocus" Value="{Binding InitialLevel, Mode=OneTime}" Text="{Binding Level, Mode=TwoWay}" IsVisible="{Binding IsLevel}" IsReadOnly="{Binding !CanEdit}" AllowSpin="{Binding CanEdit}" AutomationProperties.Name="{Binding LevelName}" Minimum="1" Classes.invalid="{Binding #ErrorMessage.IsVisible}" FormatString="0.############################" />
                <ComboBox Grid.Column="1" x:Name="GuardInput" Classes="rowFocus" ItemsSource="{Binding Guards}" SelectedItem="{Binding Guard, Mode=TwoWay}" IsVisible="{Binding IsGuard}" IsEnabled="{Binding CanEdit}" Width="132" HorizontalAlignment="Left" AutomationProperties.Name="大航海身份" />
                <TextBlock Grid.Column="2" x:Name="LevelUnit" IsVisible="{Binding IsLevel}" Classes="label" Text="级" VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
            </Grid>
            <Button Grid.Column="3" x:Name="RemoveButton" Command="{Binding Remove}" IsEnabled="{Binding CanRemove}" IsVisible="{Binding CanEdit}" AutomationProperties.Name="{Binding RemoveName}" Classes="ghost danger" Width="28" VerticalAlignment="Center">
              <Viewbox Classes="icon remove"><Path Data="{StaticResource Icon.Remove}" /></Viewbox>
            </Button>
            <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" x:Name="ErrorMessage" Classes="error" Text="{Binding VisibleError}" IsVisible="{Binding VisibleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ReadOnlyMessage" Classes="hint" IsVisible="{Binding HasReadOnlyHint}" Text="这项是多行写法，请在设置文件里改" />
          </Grid>
        </StackPanel>
      </local:EditableRowFrame>
    </DataTemplate>
  </local:SettingsPage.Resources>
  <local:SettingsPage.HeaderContent>
    <StackPanel VerticalAlignment="Center">
      <ToggleSwitch Classes="plain" x:Name="WelcomeInput" AutomationProperties.Name="进场欢迎" />
    </StackPanel>
  </local:SettingsPage.HeaderContent>
  <local:SettingsPage.HeaderNote>
    <StackPanel Margin="20,0">
      <TextBlock x:Name="WelcomeReadOnly" Classes="hint" Text="这项是多行写法，请在设置文件里改" />
      <TextBlock x:Name="WelcomeError" Classes="error" />
    </StackPanel>
  </local:SettingsPage.HeaderNote>
  <local:SettingsPage.BodyContent>
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Classes="section" Text="欢迎语" Margin="0,0,8,0" />
          <TextBlock Grid.Column="1" x:Name="WelcomeRandomHint" Classes="hint" />
        </Grid>
        <TextBlock Grid.Column="1" x:Name="WelcomeTextCount" Classes="caption muted numeric" VerticalAlignment="Center" />
      </Grid>
      <ItemsControl x:Name="WelcomeTextRows" Classes="editableRows">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:WelcomeTextRow">
            <local:EditableRowFrame>
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                <TextBox x:Name="ValueInput" Classes="rowFocus" PlaceholderText="输入欢迎语"
                  Text="{Binding Value, Mode=TwoWay}" IsReadOnly="{Binding !CanEdit}"
                  CaretIndex="{Binding CaretIndex, Mode=TwoWay}" SelectionStart="{Binding SelectionStart, Mode=TwoWay}" SelectionEnd="{Binding SelectionEnd, Mode=TwoWay}"
                  Classes.invalid="{Binding #ErrorMessage.IsVisible}" AutomationProperties.Name="{Binding Number, StringFormat='第 {0} 条欢迎语'}" />
                <Button Grid.Column="1" x:Name="RemoveButton" Classes="ghost danger" Width="28" VerticalAlignment="Center"
                  Command="{Binding Remove}" IsEnabled="{Binding CanRemove}" IsVisible="{Binding CanEdit}"
                  AutomationProperties.Name="{Binding Number, StringFormat='删除第 {0} 条欢迎语'}">
                  <Viewbox Classes="icon remove"><Path Data="{StaticResource Icon.Remove}" /></Viewbox>
                </Button>
                <TextBlock Grid.Row="1" x:Name="ErrorMessage" Classes="error" IsVisible="{Binding VisibleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding VisibleError}"
                  TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              </Grid>
            </local:EditableRowFrame>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <local:ListFoldButton x:Name="WelcomeTextFold" />
      <TextBlock x:Name="WelcomeTextReadOnly" Classes="hint" Text="这项是多行写法，请在设置文件里改" />
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
        <TextBlock Classes="caption muted" Text="插入" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Button Grid.Column="1" Classes="chip" Margin="0,0,6,0" x:Name="InsertAtButton" GettingFocus="InsertButtonGettingFocus" Content="@观众" Tag="{}{@}" Click="InsertPlaceholder" />
        <Button Grid.Column="2" Classes="chip" Margin="0,0,6,0" x:Name="InsertNicknameButton" GettingFocus="InsertButtonGettingFocus" Content="昵称" Tag="{}{昵称}" Click="InsertPlaceholder" />
        <Button Grid.Column="3" Classes="chip" Margin="0,0,6,0" x:Name="InsertGuardButton" GettingFocus="InsertButtonGettingFocus" Content="大航海身份" Tag="{}{大航海}" Click="InsertPlaceholder" />
        <TextBlock Grid.Column="4" x:Name="WelcomeInsertTarget" Classes="caption muted singleLine" VerticalAlignment="Center" />
      </Grid>
      <TextBlock x:Name="WelcomeTextHint" Classes="caption muted" TextWrapping="Wrap"
        Text="英文、数字、半角符号算 1，其他字符算 2。上限自动读取账号的。可用 {@}（只能放开头）、{昵称}、{大航海}；用 {{ 和 }} 转义花括号。" />
      <!-- Click on press: leaving a new row above shows its error and pushes this button down before the release.
           shortcut: other buttons below a new row can still lose that one click; defer the reveal to pointer release if it matters. -->
      <Button x:Name="AddWelcomeTextButton" Content="＋ 添加欢迎语" HorizontalAlignment="Left" ClickMode="Press" Click="AddWelcomeText" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,10,0,0">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock x:Name="ConditionsHeading" Classes="section" Text="欢迎条件" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Classes="hint" Text="满足任意一条就欢迎" />
        </Grid>
        <TextBlock Grid.Column="1" x:Name="ConditionCount" Classes="caption muted numeric" VerticalAlignment="Center" />
      </Grid>
      <StackPanel>
        <StackPanel x:Name="UidGroup" AutomationProperties.Name="指定观众">
          <ItemsControl x:Name="UidRows" Classes="editableRows" ItemTemplate="{StaticResource ConditionRowTemplate}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <!-- 120 = WelcomeConditionRow's icon and name columns with their spacing (18 + 8 + 90 + 8), less the button's padding of 4, so the text lines up with the UID inputs. -->
          <local:ListFoldButton x:Name="UidFold" Margin="120,0,0,8" />
        </StackPanel>
        <ItemsControl x:Name="ConditionRows" Classes="editableRows" ItemTemplate="{StaticResource ConditionRowTemplate}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
      <Grid x:Name="EmptyConditions">
        <Rectangle Stroke="{DynamicResource Border.Control}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="8" RadiusY="8" />
        <StackPanel Margin="18" Spacing="6">
          <TextBlock Classes="label" Text="还没有欢迎条件" FontWeight="SemiBold" />
          <TextBlock Classes="secondary muted" Text="现在不会欢迎任何人。点下面的“添加条件”，选要欢迎哪些观众。" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
      <TextBlock x:Name="ConditionsReadOnly" Classes="hint" />
      <Button x:Name="AddConditionButton" Content="＋ 添加条件" HorizontalAlignment="Left" ClickMode="Press">
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuItem Tag="{x:Static core:WelcomeCondition.Uid}" Click="AddConditionFromMenu" AutomationProperties.Name="添加指定观众条件">
              <MenuItem.Header>
                <StackPanel Spacing="3" Margin="0,3">
                  <TextBlock Classes="label" Text="指定观众" />
                  <TextBlock Classes="caption muted" Text="按 UID 欢迎，可以添加多条" />
                </StackPanel>
              </MenuItem.Header>
            </MenuItem>
            <MenuItem Tag="{x:Static core:WelcomeCondition.FanClubLevel}" Click="AddConditionFromMenu" AutomationProperties.Name="添加粉丝团等级条件">
              <MenuItem.Header>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,3">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="label" Text="粉丝团等级" />
                    <TextBlock Classes="caption muted" Text="本直播间粉丝团达到某一级" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" x:Name="FanClubAdded" Classes="caption muted" Text="已添加" VerticalAlignment="Center" />
                </Grid>
              </MenuItem.Header>
            </MenuItem>
            <MenuItem Tag="{x:Static core:WelcomeCondition.Guard}" Click="AddConditionFromMenu" AutomationProperties.Name="添加大航海身份条件">
              <MenuItem.Header>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,3">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="label" Text="大航海身份" />
                    <TextBlock Classes="caption muted" Text="舰长、提督或总督，含更高身份" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" x:Name="GuardAdded" Classes="caption muted" Text="已添加" VerticalAlignment="Center" />
                </Grid>
              </MenuItem.Header>
            </MenuItem>
            <MenuItem Tag="{x:Static core:WelcomeCondition.WealthLevel}" Click="AddConditionFromMenu" AutomationProperties.Name="添加荣耀等级条件">
              <MenuItem.Header>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,3">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="label" Text="荣耀等级" />
                    <TextBlock Classes="caption muted" Text="全站荣耀等级达到某一级" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" x:Name="WealthAdded" Classes="caption muted" Text="已添加" VerticalAlignment="Center" />
                </Grid>
              </MenuItem.Header>
            </MenuItem>
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </StackPanel>
  </local:SettingsPage.BodyContent>
  <local:SettingsPage.ActivityContent>
    <Grid RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="16,18,16,2">
        <TextBlock Classes="section" Text="最近欢迎" />
        <Panel Grid.Column="1">
          <TextBlock Classes="caption muted numeric" Text="{Binding SendQueue.WelcomeCount, StringFormat=共 {0:N0} 次}" VerticalAlignment="Center" />
        </Panel>
      </Grid>
      <Panel Grid.Row="1">
        <ListBox x:Name="RecentWelcomesList" Classes="plain aside" ItemsSource="{Binding SendQueue.RecentWelcomes}" ItemTemplate="{StaticResource FeatureActivityTemplate}" AutomationProperties.Name="最近欢迎" />
      </Panel>
    </Grid>
  </local:SettingsPage.ActivityContent>
</local:SettingsPage>
