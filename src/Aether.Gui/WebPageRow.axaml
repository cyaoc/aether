<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Aether.Gui"
  x:Class="Aether.Gui.WebPageRow" x:DataType="local:WebPageStatus">
  <UserControl.Resources>
    <x:String x:Key="BrowserSourceSteps">还没有推流软件连着。在直播姬里添加浏览器素材，地址和宽高照这一行填；已经加过的，右键素材 → 刷新。</x:String>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.copy Path">
      <Setter Property="Data" Value="{StaticResource Icon.Copy}" />
    </Style>
    <Style Selector="Button.copy TextBlock">
      <Setter Property="Text" Value="复制" />
    </Style>
    <Style Selector="Button.copy.copied StackPanel">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Success}" />
    </Style>
    <Style Selector="Button.copy.copied Path">
      <Setter Property="Data" Value="{StaticResource Icon.Check}" />
    </Style>
    <Style Selector="Button.copy.copied TextBlock">
      <Setter Property="Text" Value="已复制" />
    </Style>
    <Style Selector="StackPanel.pageStatus">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Text.Muted}" />
    </Style>
    <Style Selector="StackPanel.pageStatus > Ellipse">
      <Setter Property="Fill" Value="{DynamicResource Text.Disabled}" />
    </Style>
    <Style Selector="StackPanel.pageStatus.connected">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Success}" />
    </Style>
    <Style Selector="StackPanel.pageStatus.connected > Ellipse">
      <Setter Property="Fill" Value="{DynamicResource Success}" />
    </Style>
    <Style Selector="StackPanel.pageStatus.waiting">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Warning.Text}" />
    </Style>
    <Style Selector="StackPanel.pageStatus.waiting > Ellipse">
      <Setter Property="Fill" Value="{DynamicResource Warning.Dot}" />
    </Style>
    <Style Selector="TextBox.address">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontFamily" Value="Menlo, Consolas" />
      <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
    </Style>
    <!-- A page's browser source size; the text column is shared, so every row's size column is as wide as the longest. -->
    <Style Selector="ContentControl.pageSize">
      <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="PageSize" />
            </Grid.ColumnDefinitions>
            <Viewbox Classes="icon"><Path Data="{StaticResource Icon.Scan}" /></Viewbox>
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalContentAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ContentControl.pageSize /template/ Viewbox.icon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="8" Margin="12,10">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
      <Viewbox Classes="icon" Width="16" Height="16"><Path x:Name="IconPath" Stroke="{DynamicResource Accent.Text}" /></Viewbox>
      <TextBlock Grid.Column="1" Text="{Binding Texts.Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" x:Name="PurposeText" Classes="caption muted singleLine" VerticalAlignment="Center" />
      <StackPanel Grid.Column="3" Classes="pageStatus" Classes.connected="{Binding Connected}" Classes.waiting="{Binding Waiting}" Orientation="Horizontal" Spacing="6">
        <Ellipse Width="7" Height="7" VerticalAlignment="Center" />
        <TextBlock x:Name="ConnectionsText" Text="{Binding ConnectionsText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </Grid>
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBox x:Name="Address" Classes="address" Text="{Binding Address, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{Binding Texts.Name, StringFormat='{}{0}地址'}" />
      <ContentControl Grid.Column="1" x:Name="PageSize" Classes="pageSize" />
      <Button Grid.Column="2" x:Name="CopyButton" Classes="copy" Tag="{Binding Address}" Height="32" Padding="10,0,12,0" AutomationProperties.Name="{Binding Texts.Name, StringFormat='复制{0}地址'}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Viewbox Classes="icon" Width="14" Height="14"><Path StrokeThickness="2" /></Viewbox>
          <TextBlock VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>
    <Grid x:Name="SetupHelp" ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding Waiting}" TextElement.Foreground="{DynamicResource Warning.Text}">
      <Viewbox Classes="icon" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0"><Path Data="{StaticResource Icon.Alert}" StrokeThickness="2" /></Viewbox>
      <TextBlock Grid.Column="1" Classes="caption" LineHeight="18" TextWrapping="Wrap" Text="{StaticResource BrowserSourceSteps}" />
    </Grid>
  </StackPanel>
</UserControl>
