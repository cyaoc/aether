<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="Aether.Gui.WelcomeConditionRow">
  <StackPanel>
    <Grid x:Name="OrSeparator" ColumnDefinitions="*,Auto,*" ColumnSpacing="8" Margin="0,2">
      <Border Height="1" Background="{DynamicResource Border.Subtle}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Classes="caption muted" Text="或" />
      <Border Grid.Column="2" Height="1" Background="{DynamicResource Border.Subtle}" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="18,90,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" Margin="0,8">
      <Viewbox Classes="icon"><Path x:Name="TypeIcon" Stroke="{DynamicResource Text.Muted}" /></Viewbox>
      <TextBlock Grid.Column="1" x:Name="TypeName" Classes="label" VerticalAlignment="Center" />
      <Grid Grid.Column="2">
        <TextBox x:Name="UidInput" Classes="numeric" Width="200" HorizontalAlignment="Left" PlaceholderText="输入 UID" AutomationProperties.Name="指定观众 UID" />
        <Grid x:Name="ThresholdInput" ColumnDefinitions="Auto,Auto,Auto" HorizontalAlignment="Left">
          <TextBlock Classes="label" Text="达到" VerticalAlignment="Center" Margin="0,0,12,0" />
          <NumericUpDown Grid.Column="1" x:Name="LevelInput" Classes.invalid="{Binding #ErrorMessage.IsVisible}" FormatString="0.############################" />
          <ComboBox Grid.Column="1" x:Name="GuardInput" Width="132" HorizontalAlignment="Left" AutomationProperties.Name="大航海身份" />
          <TextBlock Grid.Column="2" x:Name="LevelUnit" Classes="label" Text="级" VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>
      </Grid>
      <Button Grid.Column="3" x:Name="RemoveButton" Classes="ghost danger" Content="×" Width="28" VerticalAlignment="Center" />
      <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" x:Name="ErrorMessage" Classes="error" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ReadOnlyMessage" Classes="hint" Text="这项是多行写法，请在设置文件里改" />
    </Grid>
  </StackPanel>
</UserControl>
