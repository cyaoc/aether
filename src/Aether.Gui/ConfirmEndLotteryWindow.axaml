<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aether.Gui.ConfirmEndLotteryWindow" Title="结束这场抽奖" Width="400" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="24">
    <TextBlock Text="结束后不能继续开奖，直播画面会显示完整中奖名单，直到你收起画面。" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="取消" IsCancel="True" IsDefault="True" Click="Cancel" />
      <Button x:Name="ConfirmButton" Content="结束这场抽奖" Classes="danger" Click="Confirm" />
    </StackPanel>
  </StackPanel>
</Window>
