<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Aether.Gui.WelcomeAnimationRow">
  <UserControl.Styles>
    <Style Selector="TextBox#UidInput.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
    </Style>
    <Style Selector="Button#FileButton">
      <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
    </Style>
    <Style Selector="Button#FileButton:pointerover /template/ ContentPresenter, Button#FileButton:pressed /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
    </Style>
    <Style Selector="Button#FileButton.missing">
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>
    <Style Selector="Button#FileButton.missing:pointerover /template/ ContentPresenter, Button#FileButton.missing:pressed /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>
    <Style Selector="Button#TestButton">
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style Selector="Button#TestButton:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
    </Style>
    <Style Selector="Button#TestButton.playing /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent.Tint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Tint}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
    </Style>
    <Style Selector="Grid#RowNote">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Text.Muted}" />
    </Style>
    <Style Selector="Grid#RowNote.error">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Danger}" />
    </Style>
    <Style Selector="Grid#RowNote.playing">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent.Text}" />
    </Style>
  </UserControl.Styles>
  <Border x:Name="RowBorder" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="12,8,6,8">
    <StackPanel Spacing="4">
      <Grid ColumnDefinitions="104,*,Auto,30" ColumnSpacing="8">
        <TextBox x:Name="UidInput" Classes="numeric" Height="32" MinHeight="32" FontSize="13" PlaceholderText="输入 UID" AutomationProperties.Name="观众 UID" />
        <Button Grid.Column="1" x:Name="FileButton" Classes="ghost" Height="32" Padding="8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
            <Viewbox Classes="icon" Width="16" Height="16"><Path x:Name="FileIcon" Data="{StaticResource Icon.Animation}" /></Viewbox>
            <TextBlock Grid.Column="1" x:Name="FileNameText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button Grid.Column="2" x:Name="TestButton" Height="30" MinHeight="30" Padding="8,0,10,0">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Viewbox Classes="icon" Width="14" Height="14"><Path x:Name="TestIcon" Data="{StaticResource Icon.Play}" StrokeThickness="2" /></Viewbox>
            <TextBlock x:Name="TestText" Text="试播" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" x:Name="RemoveButton" Classes="ghost danger" Width="30" Height="30">
          <Viewbox Classes="icon" Width="16" Height="16"><Path Data="{StaticResource Icon.Remove}" /></Viewbox>
        </Button>
      </Grid>
      <Grid x:Name="RowNote" ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="2,0,0,0">
        <Viewbox Classes="icon" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0"><Path x:Name="NoteIcon" StrokeThickness="2" /></Viewbox>
        <TextBlock Grid.Column="1" x:Name="RowMessage" FontSize="12" LineHeight="18" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
