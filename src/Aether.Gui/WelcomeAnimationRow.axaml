<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Aether.Gui.WelcomeAnimationRow">
  <Grid ColumnDefinitions="18,150,*,Auto,28" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="5" Margin="0,6">
    <Viewbox Classes="icon"><Path Data="{StaticResource Icon.Welcome}" Stroke="{DynamicResource Text.Muted}" /></Viewbox>
    <TextBox Grid.Column="1" x:Name="UidInput" Classes="numeric" PlaceholderText="输入 UID" AutomationProperties.Name="欢迎动画观众 UID" />
    <Button Grid.Column="3" x:Name="TestButton" Content="试播" MinWidth="58" AutomationProperties.Name="试播欢迎动画" />
    <Button Grid.Column="4" x:Name="RemoveButton" Classes="ghost danger" Width="28" AutomationProperties.Name="删除欢迎动画观众">
      <Viewbox Classes="icon remove"><Path Data="{StaticResource Icon.Remove}" /></Viewbox>
    </Button>
    <Button Grid.Column="2" x:Name="FileButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.Name="选择欢迎动画视频">
      <TextBlock x:Name="FileNameText" Classes="label" TextTrimming="CharacterEllipsis" />
    </Button>
    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" x:Name="RowMessage" Classes="caption muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  </Grid>
</UserControl>
