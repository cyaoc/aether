<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Aether.Gui"
        xmlns:core="using:Aether.Core"
        x:Class="Aether.Gui.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="Aether" Width="960" Height="640" MinWidth="760" MinHeight="520">
  <Window.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="SubtleAccentBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.12" />
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ConnectionPendingBrush" Color="#9D6500" />
          <SolidColorBrush x:Key="ConnectionReadyBrush" Color="#0F7B0F" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ConnectionPendingBrush" Color="#FCE100" />
          <SolidColorBrush x:Key="ConnectionReadyBrush" Color="#6CCB5F" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </Style>
    <Style Selector="Ellipse.status">
      <Setter Property="Fill" Value="{DynamicResource ConnectionPendingBrush}" />
    </Style>
    <Style Selector="Ellipse.status.connected">
      <Setter Property="Fill" Value="{DynamicResource ConnectionReadyBrush}" />
    </Style>
    <Style Selector="Border.account">
      <Setter Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="224,*">
    <Border Padding="16,24,16,16" BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="12">
          <TextBlock Text="Aether" FontSize="22" FontWeight="SemiBold" Margin="4,0,0,12" />
          <Border Padding="12" CornerRadius="8" BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <StackPanel Spacing="12">
              <TextBlock Classes="muted" Text="直播间" />
              <StackPanel x:Name="RoomInputPanel" Spacing="8" IsVisible="{Binding !HasRoomConnection}">
                <TextBox Text="{Binding RoomNumber}" PlaceholderText="房间号" AutomationProperties.Name="房间号" KeyDown="ConnectRoom" />
                <Button Classes="accent" Content="连接" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding ConnectCommand}" />
              </StackPanel>
              <StackPanel x:Name="RoomStatusPanel" Spacing="10" IsVisible="{Binding HasRoomConnection}">
                <TextBlock Text="{Binding RoomNumber}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Classes="status" Width="8" Height="8" VerticalAlignment="Center" Classes.connected="{Binding IsConnected}" />
                  <TextBlock Text="{Binding Status}" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Button Content="断开" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ConnectCancelCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                     IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <ListBox x:Name="Navigation" Background="Transparent" SelectionMode="AlwaysSelected" SelectionChanged="Navigate" Margin="0,8,0,0"
                   AutomationProperties.Name="功能导航">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListBox.Styles>
            <ListBoxItem>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="弹幕" />
                <TextBlock Grid.Column="1" Text="{Binding Danmaku.Count}" Classes="muted" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="盲盒统计" />
                <TextBlock Grid.Column="1" x:Name="BlindBoxStatus" Classes="muted" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="进场欢迎" />
                <TextBlock Grid.Column="1" x:Name="WelcomeStatus" Classes="muted" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem Content="发送队列" />
            <ListBoxItem Content="通用设置" />
          </ListBox>
        </StackPanel>
        <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="4,16,0,0"
                BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel VerticalAlignment="Center" Spacing="6">
              <TextBlock Text="{Binding AccountStatus.Text}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AccountStatus.Text}"
                         AutomationProperties.LiveSetting="Polite" />
              <Button x:Name="RetryAccountButton" Content="重试" Command="{Binding ReadAccountCommand}" IsVisible="{Binding AccountStatus.ReadFailed}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="AccountMenuButton" Content="⋯" VerticalAlignment="Center"
                    AutomationProperties.Name="账号菜单" IsEnabled="{Binding !IsLoggingOut}">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="退出登录…" Click="ConfirmLogout" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <Panel Grid.Column="1" x:Name="PageHost" Margin="24,24,24,16">
    <Grid x:Name="DanmakuPage" RowDefinitions="Auto,*" RowSpacing="16">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="弹幕" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="{Binding Danmaku.Count, StringFormat={}{0} 条}" VerticalAlignment="Center" />
        </StackPanel>
        <CheckBox Grid.Column="1" Content="{x:Static local:MainWindowViewModel.KeepRecentDanmakuLabel}"
                  IsChecked="{Binding KeepRecentDanmaku, Mode=TwoWay}" />
      </Grid>
      <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" ClipToBounds="True"
              BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
        <Panel>
          <Panel IsVisible="{Binding !HasQrCode}">
            <TextBlock Classes="muted" Text="连接后，弹幕会显示在这里" IsVisible="{Binding !Danmaku.Count}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ListBox x:Name="DanmakuList" ItemsSource="{Binding Danmaku}" Background="Transparent" IsVisible="{Binding !!Danmaku.Count}"
                     AutoScrollToSelectedItem="False" AutomationProperties.Name="弹幕列表" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="4,2" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:Danmaku">
                  <Border Classes.account="{Binding #AccountBadge.IsVisible}" Padding="12,10" CornerRadius="6">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Nickname}" />
                        <TextBlock Grid.Column="1" x:Name="AccountBadge" Classes="muted" Text="账号" FontSize="12">
                          <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static local:MainWindowViewModel.IsAccountDanmaku}">
                              <Binding Path="Uid" />
                              <Binding Path="$parent[Window].((local:MainWindowViewModel)DataContext).AccountStatus.Account" />
                            </MultiBinding>
                          </TextBlock.IsVisible>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Classes="muted" Text="{Binding ReceivedAt, StringFormat={}{0:HH:mm:ss}}" FontSize="12" />
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding Content}" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
          <StackPanel IsVisible="{Binding HasQrCode}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <!-- Scanners want dark modules on light, so the code stays white in dark mode too. -->
            <Border Background="White" CornerRadius="12" Padding="8" Margin="0,0,0,8" HorizontalAlignment="Center">
              <Image Source="{Binding QrCode}" Width="240" Height="240" Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="None" AutomationProperties.Name="B站登录二维码" />
            </Border>
            <TextBlock Text="用 B站 App 扫码并确认登录" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="过期后自动换码，点“断开”取消" HorizontalAlignment="Center" />
          </StackPanel>
        </Panel>
      </Border>
    </Grid>
    </Panel>
  </Grid>
</Window>
