<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Aether.Gui"
        xmlns:core="using:Aether.Core"
        x:Class="Aether.Gui.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="Aether" Width="800" Height="600" MinWidth="560" MinHeight="480">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
      <TextBlock Text="房间号" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding RoomNumber}" PlaceholderText="输入直播间短号或真实房间号"
               IsEnabled="{Binding CanConnect}" AutomationProperties.Name="房间号" />
      <Button Grid.Column="2" Content="连接" Command="{Binding ConnectCommand}" IsVisible="{Binding !IsWatching}" />
      <Button Grid.Column="2" Content="断开" Command="{Binding ConnectCancelCommand}" IsVisible="{Binding IsWatching}" />
      <Button Grid.Column="3" Content="退出登录" Command="{Binding LogoutCommand}" />
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite" />
    <Grid Grid.Row="3">
      <Grid RowDefinitions="Auto,*" IsVisible="{Binding !HasQrCode}">
        <Grid ColumnDefinitions="90,160,*" Margin="12,0,12,8" ColumnSpacing="12">
          <TextBlock Text="时间" />
          <TextBlock Grid.Column="1" Text="昵称" />
          <TextBlock Grid.Column="2" Text="内容" />
        </Grid>
        <ListBox Grid.Row="1" ItemsSource="{Binding Danmaku}"
                 AutomationProperties.Name="弹幕列表" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="core:Danmaku">
              <Grid ColumnDefinitions="90,160,*" ColumnSpacing="12" Margin="0,4">
                <TextBlock Text="{Binding ReceivedAt, StringFormat={}{0:HH:mm:ss}}" />
                <TextBlock Grid.Column="1" Text="{Binding Nickname}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="2" Text="{Binding Content}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <StackPanel IsVisible="{Binding HasQrCode}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <Image Source="{Binding QrCode}" Width="240" Height="240" Stretch="Uniform"
               RenderOptions.BitmapInterpolationMode="None" AutomationProperties.Name="B站登录二维码" />
        <TextBlock Text="请用 B站 App 扫码并确认登录" HorizontalAlignment="Center" />
        <TextBlock Text="过期后自动换码，点“断开”取消" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
