<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Aether.Gui" xmlns:core="using:Aether.Core"
        x:Class="Aether.Gui.MainWindow" x:DataType="local:MainWindowViewModel"
        Title="Aether" Width="1200" Height="720" MinWidth="1040" MinHeight="600">
  <Panel>
    <Grid x:Name="LoginPage" ColumnDefinitions="400,*" IsVisible="{Binding IsLoginPage}">
      <Border Background="{DynamicResource Accent.Tint}" Padding="44,56">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="14">
            <TextBlock Text="Aether" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource Accent.Text}" />
            <TextBlock Classes="singleLine" Text="B站直播 bot，以你的账号守着直播间" FontSize="15" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="26" VerticalAlignment="Top" Margin="0,28,0,0">
            <Grid ColumnDefinitions="20,*" ColumnSpacing="14">
              <Viewbox Classes="icon" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0"><Path Data="{StaticResource Icon.BlindBox}" Stroke="{DynamicResource Accent}" /></Viewbox>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="盲盒统计" FontWeight="SemiBold" />
                <TextBlock Classes="label singleLine" Text="查今日或本月盈亏，送完一轮自动播报" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="20,*" ColumnSpacing="14">
              <Viewbox Classes="icon" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0"><Path Data="{StaticResource Icon.Welcome}" Stroke="{DynamicResource Accent}" /></Viewbox>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="进场欢迎" FontWeight="SemiBold" />
                <TextBlock Classes="label singleLine" Text="舰长、粉丝团、指定观众进场时发欢迎弹幕" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="20,*" ColumnSpacing="14">
              <Viewbox Classes="icon" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0"><Path Data="{StaticResource Icon.Danmaku}" Stroke="{DynamicResource Accent}" /></Viewbox>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="实时弹幕" FontWeight="SemiBold" />
                <TextBlock Classes="label singleLine" Text="断线自动重连，账号发的弹幕单独标出" />
              </StackPanel>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Accent}">
              <TextBlock Text="1" Classes="caption numeric" Foreground="{DynamicResource Accent.OnSolid}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="登录账号" Classes="secondary accent" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Width="18" Height="1" Background="{DynamicResource Border.Control}" VerticalAlignment="Center" />
            <Border Width="24" Height="24" CornerRadius="12" BorderBrush="{DynamicResource Text.Muted}" BorderThickness="1">
              <TextBlock Text="2" Classes="caption numeric" Foreground="{DynamicResource Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="选择直播间" Classes="label" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" Spacing="12" Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="扫码登录 B站" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Classes="singleLine secondary muted" Text="登录后选择直播间，下次打开直接进入" TextAlignment="Center" />
        <Border Classes="qr" Margin="0,14" HorizontalAlignment="Center">
          <Panel Width="224" Height="224">
            <Panel IsVisible="{Binding LoginCommand.IsRunning}">
              <TextBlock Classes="hint" Text="正在获取二维码…" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasQrCode}" />
            </Panel>
            <!-- Scanners require dark modules on a light background in either theme. -->
            <Border Background="White" IsVisible="{Binding HasQrCode}">
              <Image x:Name="LoginQrImage" Source="{Binding QrCode}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" AutomationProperties.Name="B站登录二维码" />
            </Border>
            <StackPanel Spacing="12" VerticalAlignment="Center" IsVisible="{Binding LoginError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Classes="error" Text="{Binding LoginError}" TextAlignment="Center" />
              <Button x:Name="RetryLoginButton" Content="重试" Command="{Binding LoginCommand}" HorizontalAlignment="Center" />
            </StackPanel>
          </Panel>
        </Border>
        <TextBlock Classes="singleLine secondary" Text="打开 B站 App 扫一扫，在手机上确认" FontWeight="SemiBold" TextAlignment="Center" />
        <TextBlock Classes="singleLine caption muted" Text="二维码过期后会自动换新" TextAlignment="Center" />
        <Button x:Name="OpenSettingsWithoutLoginButton" Content="先设置，无需登录" Classes="ghost" HorizontalAlignment="Center" Click="OpenSettingsWithoutLogin" />
      </StackPanel>
    </Grid>
    <Grid ColumnDefinitions="224,*" IsVisible="{Binding !IsLoginPage}">
      <Border Padding="12,14" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Border}" Background="{DynamicResource Surface.Sidebar}">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="12">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="caption muted" Text="直播间" />
                <StackPanel x:Name="RoomInputPanel" Spacing="8" IsVisible="{Binding !HasRoomConnection}">
                  <ComboBox x:Name="RoomInput" Classes="numeric history" IsEditable="True" ItemsSource="{Binding RecentRooms}" Text="{Binding RoomNumber}" HorizontalAlignment="Stretch" PlaceholderText="房间号" AutomationProperties.Name="房间号">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                          <TextBlock Classes="numeric" Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <Button Grid.Column="1" Classes="ghost danger" Width="24" Height="24" MinHeight="24" Padding="0" VerticalAlignment="Center"
                                  Command="{Binding $parent[ComboBox].((local:MainWindowViewModel)DataContext).RemoveRecentRoomCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding StringFormat=从最近列表中删除 {0}}" ToolTip.Tip="从最近列表中删除">
                            <Viewbox Classes="icon remove"><Path Data="{StaticResource Icon.Remove}" /></Viewbox>
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Classes="accent" Content="连接" HorizontalAlignment="Stretch" Command="{Binding ConnectCommand}" />
                </StackPanel>
                <StackPanel x:Name="RoomStatusPanel" Spacing="8" IsVisible="{Binding HasRoomConnection}">
                  <TextBlock Classes="numeric" Text="{Binding RoomNumber}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Classes="status" Width="7" Height="7" VerticalAlignment="Center" Classes.connected="{Binding IsConnected}" />
                    <TextBlock Classes="connection" Classes.connected="{Binding IsConnected}" Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
                  </StackPanel>
                  <Button Content="断开" HorizontalAlignment="Stretch" Command="{Binding ConnectCancelCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Classes="error" Text="{Binding Message}" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ListBox x:Name="Navigation" Classes="nav" SelectionMode="AlwaysSelected" SelectionChanged="Navigate" Margin="0,4,0,0" AutomationProperties.Name="功能导航">
              <ListBoxItem>
                <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="10">
                  <Viewbox Classes="icon"><Path Data="{StaticResource Icon.Danmaku}" /></Viewbox>
                  <TextBlock Grid.Column="1" Text="弹幕" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="caption muted numeric" Text="{Binding Danmaku.Count, StringFormat={}{0:N0}}" />
                </Grid>
              </ListBoxItem>
              <ListBoxItem>
                <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="10">
                  <Viewbox Classes="icon"><Path Data="{StaticResource Icon.BlindBox}" /></Viewbox>
                  <TextBlock Grid.Column="1" Text="盲盒统计" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" x:Name="BlindBoxStatus" Classes="caption muted" />
                </Grid>
              </ListBoxItem>
              <ListBoxItem>
                <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="10">
                  <Viewbox Classes="icon"><Path Data="{StaticResource Icon.Welcome}" /></Viewbox>
                  <TextBlock Grid.Column="1" Text="进场欢迎" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" x:Name="WelcomeStatus" Classes="caption muted" />
                </Grid>
              </ListBoxItem>
              <ListBoxItem>
                <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="10">
                  <Viewbox Classes="icon"><Path Data="{StaticResource Icon.Animation}" /></Viewbox>
                  <TextBlock Grid.Column="1" Text="欢迎动画" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" x:Name="AnimationStatus" Classes="caption muted" />
                </Grid>
              </ListBoxItem>
              <ListBoxItem>
                <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="10">
                  <Viewbox Classes="icon"><Path Data="{StaticResource Icon.Lottery}" /></Viewbox>
                  <TextBlock Grid.Column="1" Text="抽奖" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" x:Name="LotteryStatus" Classes="caption accent" Text="{Binding LotteryPhaseText}" />
                </Grid>
              </ListBoxItem>
              <ListBoxItem>
                <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="10">
                  <Viewbox Classes="icon"><Path Data="{StaticResource Icon.Send}" /></Viewbox>
                  <TextBlock Grid.Column="1" Text="发送队列" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" x:Name="PendingSendCount" Classes="caption muted numeric" Text="{Binding SendQueue.PendingSends.Count, StringFormat={}{0:N0} 条待发}" IsVisible="{Binding !!SendQueue.PendingSends.Count}" />
                </Grid>
              </ListBoxItem>
              <ListBoxItem>
                <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="10">
                  <Viewbox Classes="icon"><Path Data="{StaticResource Icon.Settings}" /></Viewbox>
                  <TextBlock Grid.Column="1" Text="通用设置" VerticalAlignment="Center" />

                </Grid>
              </ListBoxItem>
            </ListBox>
          </StackPanel>
          <Grid Grid.Row="2" ColumnDefinitions="32,*,Auto" ColumnSpacing="10" Margin="6,12,0,0">
            <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Accent}" VerticalAlignment="Center" IsVisible="{Binding AccountStatus.Account, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding AccountStatus.Account.Nickname, Converter={x:Static local:AvatarConverter.Initial}}" Foreground="{DynamicResource Accent.OnSolid}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
              <TextBlock Classes="secondary singleLine" Text="{Binding AccountStatus.Text}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Classes="caption muted" Text="已登录" IsVisible="{Binding AccountStatus.Account, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Button x:Name="RetryAccountButton" Content="重试" Command="{Binding ReadAccountCommand}" IsVisible="{Binding AccountStatus.ReadFailed}" />
              <Button Content="登录账号" Command="{Binding OpenLoginPageCommand}" IsVisible="{Binding IsLoggedOut}" />
            </StackPanel>
            <Button Grid.Column="2" x:Name="LogoutButton" Classes="ghost danger" Padding="6" VerticalAlignment="Center" Click="ConfirmLogout"
                    ToolTip.Tip="退出登录" AutomationProperties.Name="退出登录" IsEnabled="{Binding !IsLoggingOut}" IsVisible="{Binding !IsLoggedOut}">
              <Viewbox Classes="icon"><Path Data="{StaticResource Icon.Logout}" /></Viewbox>
            </Button>
          </Grid>
        </Grid>
      </Border>
      <Panel Grid.Column="1">
        <Panel x:Name="PageHost" IsVisible="{Binding !HasQrCode}">
          <Grid x:Name="DanmakuPage" RowDefinitions="60,*">
            <Border Classes="pageHeader">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <TextBlock Text="弹幕" Classes="h1" />
                  <TextBlock Classes="caption muted numeric" Text="{Binding Danmaku.Count, StringFormat={}{0:N0} 条}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <TextBlock Classes="caption muted" Text="{x:Static local:MainWindowViewModel.KeepRecentDanmakuLabel}" VerticalAlignment="Center" />
                  <ToggleSwitch Classes="plain" IsChecked="{Binding KeepRecentDanmaku, Mode=TwoWay}" AutomationProperties.Name="只保留最近 1000 条" />
                </StackPanel>
              </Grid>
            </Border>
            <Panel Grid.Row="1">
              <TextBlock Classes="hint" Text="连接后，弹幕会显示在这里" IsVisible="{Binding !Danmaku.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <ListBox x:Name="DanmakuList" Classes="plain" ItemsSource="{Binding Danmaku}" IsVisible="{Binding !!Danmaku.Count}" AutomationProperties.Name="弹幕列表">
                <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="core:Danmaku">
                    <Border x:Name="DanmakuRow" Classes.account="{Binding #AccountBadge.IsVisible}" Margin="8,0,8,2" Padding="12,8" CornerRadius="8"
                            Classes.captain="{Binding GuardTier, Converter={x:Static local:MainWindowViewModel.IsCaptain}}"
                            Classes.admiral="{Binding GuardTier, Converter={x:Static local:MainWindowViewModel.IsAdmiral}}"
                            Classes.governor="{Binding GuardTier, Converter={x:Static local:MainWindowViewModel.IsGovernor}}">
                      <Grid ColumnDefinitions="30,*" ColumnSpacing="10">
                        <Border x:Name="Avatar" Width="30" Height="30" CornerRadius="15" VerticalAlignment="Top" Margin="0,2,0,0">
                          <Border.Background>
                            <MultiBinding Converter="{x:Static local:AvatarConverter.Instance}" ConverterParameter="Background">
                              <Binding Path="Nickname" /><Binding Path="$parent[Window].ActualThemeVariant" /><Binding ElementName="AccountBadge" Path="IsVisible" />
                            </MultiBinding>
                          </Border.Background>
                          <TextBlock Text="{Binding Nickname, Converter={x:Static local:AvatarConverter.Initial}}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                              <MultiBinding Converter="{x:Static local:AvatarConverter.Instance}" ConverterParameter="Foreground">
                                <Binding Path="Nickname" /><Binding Path="$parent[Window].ActualThemeVariant" /><Binding ElementName="AccountBadge" Path="IsVisible" />
                              </MultiBinding>
                            </TextBlock.Foreground>
                          </TextBlock>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                          <WrapPanel x:Name="DanmakuHeader" Orientation="Horizontal" ItemSpacing="8" LineSpacing="3">
                            <TextBlock Classes="secondary singleLine" Classes.accent="{Binding #AccountBadge.IsVisible}" Text="{Binding Nickname}" FontWeight="SemiBold" MaxWidth="250" />
                            <Border Classes="badge accountBadge" IsVisible="{Binding #AccountBadge.IsVisible}">
                              <TextBlock x:Name="AccountBadge" Text="账号">
                                <TextBlock.IsVisible>
                                  <MultiBinding Converter="{x:Static local:MainWindowViewModel.IsAccountDanmaku}">
                                    <Binding Path="Uid" /><Binding Path="$parent[Window].((local:MainWindowViewModel)DataContext).AccountStatus.Account" />
                                  </MultiBinding>
                                </TextBlock.IsVisible>
                              </TextBlock>
                            </Border>
                            <Border Classes="badge guardBadge" IsVisible="{Binding !!GuardTier}">
                              <TextBlock Text="{Binding GuardName}" />
                            </Border>
                            <Border Classes="badge neutralBadge" IsVisible="{Binding FanClubLevel, Converter={x:Static ObjectConverters.IsNotNull}}">
                              <TextBlock Text="{Binding FanClubLevel, StringFormat=粉丝团 {0}}" />
                            </Border>
                            <Border Classes="badge neutralBadge" IsVisible="{Binding !!WealthLevel}">
                              <TextBlock Text="{Binding WealthLevel, StringFormat=荣耀 {0}}" />
                            </Border>
                            <TextBlock Classes="caption muted numeric" Text="{Binding ReceivedAt, StringFormat={}{0:HH:mm:ss}}" VerticalAlignment="Center" />
                          </WrapPanel>
                          <TextBlock x:Name="DanmakuContent" FontSize="14" LineHeight="21" TextWrapping="Wrap"><Run Text="{Binding ReplyName, Converter={x:Static local:MainWindowViewModel.ReplyPrefix}}" Foreground="{DynamicResource Accent.Text}" FontWeight="SemiBold" /><Run Text="{Binding Content}" /></TextBlock>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </Grid>
        </Panel>
        <StackPanel x:Name="WatchLoginCard" IsVisible="{Binding HasQrCode}" Spacing="16" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Classes="singleLine h1" Text="登录已失效，请重新扫码" TextAlignment="Center" />
          <Border Classes="qr" HorizontalAlignment="Center">
            <Border Background="White">
              <Image Source="{Binding QrCode}" Width="224" Height="224" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" AutomationProperties.Name="B站登录二维码" />
            </Border>
          </Border>
          <TextBlock Classes="singleLine secondary" Text="打开 B站 App 扫一扫，在手机上确认" FontWeight="SemiBold" TextAlignment="Center" />
          <TextBlock Classes="singleLine caption muted" Text="二维码过期后会自动换新" TextAlignment="Center" />
        </StackPanel>
      </Panel>
    </Grid>
  </Panel>
</Window>
