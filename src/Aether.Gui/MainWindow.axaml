<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Aether.Gui"
        xmlns:core="using:Aether.Core"
        x:Class="Aether.Gui.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="Aether" Width="960" Height="640" MinWidth="760" MinHeight="520">
  <Window.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="SubtleAccentBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.12" />
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ConnectionPendingBrush" Color="#9D6500" />
          <SolidColorBrush x:Key="ConnectionReadyBrush" Color="#0F7B0F" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ConnectionPendingBrush" Color="#FCE100" />
          <SolidColorBrush x:Key="ConnectionReadyBrush" Color="#6CCB5F" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </Style>
    <Style Selector="Ellipse.status">
      <Setter Property="Fill" Value="{DynamicResource ConnectionPendingBrush}" />
    </Style>
    <Style Selector="Ellipse.status.connected">
      <Setter Property="Fill" Value="{DynamicResource ConnectionReadyBrush}" />
    </Style>
    <Style Selector="Border.account">
      <Setter Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
    </Style>
  </Window.Styles>
  <Panel>
  <Grid x:Name="LoginPage" ColumnDefinitions="*,*" Margin="40" ColumnSpacing="40" IsVisible="{Binding IsLoginPage}">
    <StackPanel Spacing="24" VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock Text="Aether" FontSize="36" FontWeight="SemiBold" />
        <TextBlock Classes="muted" Text="陪你照看直播间的 B站直播 bot" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Spacing="18">
        <StackPanel Spacing="4">
          <TextBlock Text="盲盒统计" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="记录观众的盲盒投入与盈亏，自动回复和播报。" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="进场欢迎" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="按你设定的条件，欢迎进入直播间的观众。" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="实时弹幕" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="查看直播间弹幕，认出账号发出的消息。" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
      <TextBlock Text="① 登录账号 → ② 选择直播间" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Column="1" Padding="20" CornerRadius="12" VerticalAlignment="Center"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="1">
      <StackPanel Spacing="16">
        <TextBlock Text="扫码登录 B站" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <Panel MinHeight="240">
          <Panel IsVisible="{Binding LoginCommand.IsRunning}">
            <TextBlock Classes="muted" Text="正在获取二维码…" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !HasQrCode}" />
          </Panel>
          <!-- Scanners want dark modules on light, even in dark mode. -->
          <Border Background="White" Padding="8" CornerRadius="8" HorizontalAlignment="Center" IsVisible="{Binding HasQrCode}">
            <Image x:Name="LoginQrImage" Source="{Binding QrCode}" Width="224" Height="224" Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="None" AutomationProperties.Name="B站登录二维码" />
          </Border>
          <StackPanel Spacing="12" VerticalAlignment="Center" IsVisible="{Binding LoginError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding LoginError}" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="RetryLoginButton" Content="重试" Command="{Binding LoginCommand}" HorizontalAlignment="Center" />
          </StackPanel>
        </Panel>
        <TextBlock Text="打开 B站 App 扫一扫，在手机上确认" TextWrapping="Wrap" TextAlignment="Center" />
        <TextBlock Classes="muted" Text="二维码过期后会自动换新" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
  <Grid ColumnDefinitions="224,*" IsVisible="{Binding !IsLoginPage}">
    <Border Padding="16,24,16,16" BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="12">
          <TextBlock Text="Aether" FontSize="22" FontWeight="SemiBold" Margin="4,0,0,12" />
          <Border Padding="12" CornerRadius="8" BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <StackPanel Spacing="12">
              <TextBlock Classes="muted" Text="直播间" />
              <StackPanel x:Name="RoomInputPanel" Spacing="8" IsVisible="{Binding !HasRoomConnection}">
                <TextBox Text="{Binding RoomNumber}" PlaceholderText="房间号" AutomationProperties.Name="房间号" KeyDown="ConnectRoom" />
                <Button Classes="accent" Content="连接" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding ConnectCommand}" />
              </StackPanel>
              <StackPanel x:Name="RoomStatusPanel" Spacing="10" IsVisible="{Binding HasRoomConnection}">
                <TextBlock Text="{Binding RoomNumber}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Classes="status" Width="8" Height="8" VerticalAlignment="Center" Classes.connected="{Binding IsConnected}" />
                  <TextBlock Text="{Binding Status}" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Button Content="断开" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ConnectCancelCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                     IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <ListBox x:Name="Navigation" Background="Transparent" SelectionMode="AlwaysSelected" SelectionChanged="Navigate" Margin="0,8,0,0"
                   AutomationProperties.Name="功能导航">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListBox.Styles>
            <ListBoxItem>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="弹幕" />
                <TextBlock Grid.Column="1" Text="{Binding Danmaku.Count}" Classes="muted" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="盲盒统计" />
                <TextBlock Grid.Column="1" x:Name="BlindBoxStatus" Classes="muted" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="进场欢迎" />
                <TextBlock Grid.Column="1" x:Name="WelcomeStatus" Classes="muted" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <TextBlock Text="发送队列" />
                <TextBlock Grid.Column="1" x:Name="PendingSendCount" Classes="muted" FontSize="12" VerticalAlignment="Center"
                           Text="{Binding PendingSends.Count, StringFormat={}{0} 条待发}" IsVisible="{Binding !!PendingSends.Count}" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem Content="通用设置" />
          </ListBox>
        </StackPanel>
        <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="4,16,0,0"
                BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel VerticalAlignment="Center" Spacing="6">
              <TextBlock Text="{Binding AccountStatus.Text}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AccountStatus.Text}"
                         AutomationProperties.LiveSetting="Polite" />
              <Button x:Name="RetryAccountButton" Content="重试" Command="{Binding ReadAccountCommand}" IsVisible="{Binding AccountStatus.ReadFailed}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="AccountMenuButton" Content="⋯" VerticalAlignment="Center"
                    AutomationProperties.Name="账号菜单" IsEnabled="{Binding !IsLoggingOut}">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="退出登录…" Click="ConfirmLogout" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <Panel Grid.Column="1" Margin="24,24,24,16">
    <Panel x:Name="PageHost" IsVisible="{Binding !HasQrCode}">
    <Grid x:Name="DanmakuPage" RowDefinitions="Auto,*" RowSpacing="16">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="弹幕" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="{Binding Danmaku.Count, StringFormat={}{0} 条}" VerticalAlignment="Center" />
        </StackPanel>
        <CheckBox Grid.Column="1" Content="{x:Static local:MainWindowViewModel.KeepRecentDanmakuLabel}"
                  IsChecked="{Binding KeepRecentDanmaku, Mode=TwoWay}" />
      </Grid>
      <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" ClipToBounds="True"
              BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
          <Panel>
            <TextBlock Classes="muted" Text="连接后，弹幕会显示在这里" IsVisible="{Binding !Danmaku.Count}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ListBox x:Name="DanmakuList" ItemsSource="{Binding Danmaku}" Background="Transparent" IsVisible="{Binding !!Danmaku.Count}"
                     AutoScrollToSelectedItem="False" AutomationProperties.Name="弹幕列表" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="4,2" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:Danmaku">
                  <Border Classes.account="{Binding #AccountBadge.IsVisible}" Padding="12,10" CornerRadius="6">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Nickname}" />
                        <TextBlock Grid.Column="1" x:Name="AccountBadge" Classes="muted" Text="账号" FontSize="12">
                          <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static local:MainWindowViewModel.IsAccountDanmaku}">
                              <Binding Path="Uid" />
                              <Binding Path="$parent[Window].((local:MainWindowViewModel)DataContext).AccountStatus.Account" />
                            </MultiBinding>
                          </TextBlock.IsVisible>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Classes="muted" Text="{Binding ReceivedAt, StringFormat={}{0:HH:mm:ss}}" FontSize="12" />
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding Content}" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
      </Border>
    </Grid>
    </Panel>
    <Border x:Name="WatchLoginCard" IsVisible="{Binding HasQrCode}" Padding="24" CornerRadius="12"
            HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <StackPanel Spacing="16">
        <TextBlock Text="登录已失效，请重新扫码" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
        <Border Background="White" CornerRadius="8" Padding="8" HorizontalAlignment="Center">
          <Image Source="{Binding QrCode}" Width="224" Height="224" Stretch="Uniform"
                 RenderOptions.BitmapInterpolationMode="None" AutomationProperties.Name="B站登录二维码" />
        </Border>
        <TextBlock Text="打开 B站 App 扫一扫，在手机上确认" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="二维码过期后会自动换新" TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    </Panel>
  </Grid>
  </Panel>
</Window>
