+    public void ShowWebService() => Tabs.SelectedIndex = 0;
+
+    private void ShowTab()
+    {
+        WebServiceTab.IsVisible = Tabs.SelectedIndex == 0;
+        UpdateTab.IsVisible = Tabs.SelectedIndex == 1;
+        PagesTab.IsVisible = Tabs.SelectedIndex == 0;
+        TimingHint = Tabs.SelectedIndex == 0 ? "端口保存后立即生效" : "日志设置重启后生效；自动更新下次打开时生效";
+    }
+
+    private void ShowPage()
+    {
+        WebPageRow[] rows = [VideoRow, LotteryRow, GiftBoardRow, DesktopPetRow];
+        for (var i = 0; i < rows.Length; i++) rows[i].IsVisible = i == PageList.SelectedIndex;
+    }
+
     protected override bool AppliesToWebService => true;
     private bool PortChanged => settings.WebServicePort.CanEdit && WebPortInput.Text != original.GetValueOrDefault(settings.WebServicePort.Name);
     protected override string DirtyDescription => PortChanged ? "保存后网页服务换到新端口，直播姬里的地址要跟着改" : base.DirtyDescription;
